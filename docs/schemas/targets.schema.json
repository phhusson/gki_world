{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phhusson/gki_world/docs/schemas/targets.schema.json",
  "title": "gki_world targets.yaml",
  "description": "The kernel build matrix. Layer targets must be a subset of these ids.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "floor", "targets"],
  "properties": {
    "schema": {
      "const": 1
    },
    "floor": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "repo", "ref"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([0-9]+\\.[0-9]+|stable|master)$"
          },
          "kind": {
            "enum": ["lts", "release", "master"]
          },
          "repo": {
            "type": "string",
            "format": "uri"
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean",
            "default": false,
            "description": "Every new contribution must build this target."
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
