diff --git a/cmd/gkiw.c b/cmd/gkiw.c
index 56071d89..77e6c0ad 100644
--- a/cmd/gkiw.c
+++ b/cmd/gkiw.c
@@ -10,6 +10,7 @@
 #include <console.h>
 #include <cpu_func.h>
 #include <dm.h>
+#include <env.h>
 #include <gkiw.h>
 #include <linux/string.h>
 #include <linux/stringify.h>
@@ -245,6 +246,10 @@ static int gkiw_wdt_arm(u64 timeout_ms)
 	struct udevice *dev;
 	int ret;
 
+	/* The MT6739 TOPRGU cannot go beyond CONFIG_GKIW_WDT_TIMEOUT_MS. */
+	if (!timeout_ms || timeout_ms > GKIW_WDT_DEFAULT_MS)
+		timeout_ms = GKIW_WDT_DEFAULT_MS;
+
 	ret = gkiw_wdt_get(&dev);
 	if (ret)
 		return ret;
@@ -271,12 +276,27 @@ static int gkiw_wdt_disarm(void)
  */
 void fastboot_preboot(void)
 {
-	int ret = gkiw_wdt_arm(GKIW_WDT_DEFAULT_MS);
+	const char *override = env_get("gkiw_wdt_preboot");
+	u64 timeout_ms = GKIW_WDT_DEFAULT_MS;
+	int ret;
+
+	if (override) {
+		if (!strcmp(override, "off")) {
+			ret = gkiw_wdt_disarm();
+			printf("gkiw: watchdog left off for this boot (power-cycle if the OS hangs)\n");
+			env_set("gkiw_wdt_preboot", NULL);
+			return;
+		}
+		timeout_ms = simple_strtoul(override, NULL, 10);
+		env_set("gkiw_wdt_preboot", NULL);
+	}
+
+	ret = gkiw_wdt_arm(timeout_ms);
 
 	if (ret)
 		printf("gkiw: cannot arm watchdog (%d)\n", ret);
 	else
-		printf("gkiw: watchdog armed for %d ms\n", GKIW_WDT_DEFAULT_MS);
+		printf("gkiw: watchdog armed for %lld ms\n", timeout_ms);
 }
 
