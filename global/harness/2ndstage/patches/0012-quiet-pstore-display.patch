@@ -906,8 +910,18 @@ static void oem_pstore_display(char *cmd_parameter, char *response)
 		type = "user";
 	snprintf(cmd, sizeof(cmd), "pstore display %s", type);
 
+	/*
+	 * Keep the decoded records off the 115200 UART and out of the
+	 * persistent 2ndstage log. The console record still captures them
+	 * for the fastboot stream.
+	 */
+	gkiw_log_pause(true);
+	flags = gd->flags;
+	gd->flags |= GD_FLG_SILENT;
 	console_record_reset();
 	run_command(cmd, 0);
+	gd->flags = flags;
+	gkiw_log_pause(false);
 
