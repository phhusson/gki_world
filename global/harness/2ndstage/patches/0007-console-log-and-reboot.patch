 #include <dm.h>
+#include <console.h>
 #include <env.h>
+#include <fastboot.h>
 #include <init.h>
 #include <net.h>
 #include <vsprintf.h>
@@ -28,6 +30,11 @@ int meson_board_late_init(void)
 	char serial_hex[2 * SM_SERIAL_SIZE + 1];
 	int i;
 
+#if CONFIG_IS_ENABLED(CONSOLE_RECORD)
+	/* Start a clean recording for the fastboot session and crash log. */
+	console_record_reset_enable();
+#endif
+
 	if (!meson_sm_get_serial(serial, sizeof(serial))) {
