+#include <console.h>
 #include <cpu_func.h>
 #include <dm.h>
 #include <gkiw.h>
@@ -56,9 +57,12 @@ static void gkiw_log_sync(void)
 void gkiw_log_crash(struct pt_regs *regs)
 {
 	struct gkiw_log_hdr *hdr = gkiw_log_header();
+	char *data = gkiw_log_data();
+	u32 cap = gkiw_log_capacity();
+	u32 used = 0;
 	static char buf[1024];
 	u32 seq = 0;
-	int used = 0;
+	int len = 0;
 	int ret;
 	int i;
 
@@ -69,28 +73,45 @@ void gkiw_log_crash(struct pt_regs *regs)
 		seq = hdr->seq;
 	seq++;
 
-	ret = snprintf(buf + used, sizeof(buf) - used,
+#if CONFIG_IS_ENABLED(CONSOLE_RECORD)
+	{
+		u32 console_cap = cap > sizeof(buf) ? cap - sizeof(buf) : 0;
+
+		while (used + 1 < console_cap && !console_record_isempty()) {
+			ret = console_record_readline(data + used,
+						      console_cap - used);
+			if (ret <= 0)
+				break;
+			used += ret;
+		}
+		if (used > 0 && data[used - 1] != '\n' && used < console_cap)
+			data[used++] = '\n';
+	}
+#endif
+
+	ret = snprintf(buf + len, sizeof(buf) - len,
 		       "gkiw 2ndstage crash #%u\nesr=0x%016lx elr=0x%016lx spsr=0x%016lx\n",
