 	if (ret > 0)
-		used += ret;
-	if (used >= (int)sizeof(buf))
-		used = sizeof(buf);
+		len += ret;
+	if (len >= (int)sizeof(buf))
+		len = sizeof(buf);
 
-	for (i = 0; i < 31 && used < (int)sizeof(buf); i++) {
-		ret = snprintf(buf + used, sizeof(buf) - used,
+	for (i = 0; i < 31 && len < (int)sizeof(buf); i++) {
+		ret = snprintf(buf + len, sizeof(buf) - len,
 			       "x%-2d=0x%016lx%s", i, regs->regs[i],
 			       (i & 1) ? "\n" : " ");
 		if (ret > 0)
-			used += ret;
+			len += ret;
 	}
-	if (used >= (int)sizeof(buf))
-		used = sizeof(buf);
+	if (len >= (int)sizeof(buf))
+		len = sizeof(buf);
 
-	if (used > (int)gkiw_log_capacity())
-		used = gkiw_log_capacity();
+	if (used + len > cap)
+		len = cap - used;
+	memcpy(data + used, buf, len);
+	used += len;
 
-	memcpy(gkiw_log_data(), buf, used);
 	hdr->len = used;
 	hdr->seq = seq;
 	hdr->magic = GKIW_LOG_MAGIC;
