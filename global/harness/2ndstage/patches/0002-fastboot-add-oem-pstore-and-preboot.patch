@@ -741,6 +755,90 @@ static void __maybe_unused oem_board(char *cmd_parameter, char *response)
 	fastboot_oem_board(cmd_parameter, (void *)fastboot_buf_addr, image_size, response);
 }
 
+#if CONFIG_IS_ENABLED(FASTBOOT_CMD_OEM_PSTORE)
+#define GKIW_PSTORE_CHUNK	24
+
+static ulong gkiw_pstore_addr;
+static ulong gkiw_pstore_size;
+static ulong gkiw_pstore_offset;
+static bool gkiw_pstore_active;
+
+/**
+ * oem_pstore() - Start streaming a RAM region to the host
+ *
+ * @cmd_parameter: "<addr>:<size>" in hex
+ * @response: Pointer to fastboot response buffer
+ *
+ * The actual data is sent by oem_pstore_next(), which the fastboot
+ * multiresponse machinery calls until the region is exhausted.
+ */
+static void oem_pstore(char *cmd_parameter, char *response)
+{
+	char *end;
+	ulong addr, size;
+
+	if (!cmd_parameter) {
+		fastboot_fail("missing pstore region", response);
+		return;
+	}
+
+	addr = hextoul(cmd_parameter, &end);
+	if (end == cmd_parameter || *end != ':') {
+		fastboot_fail("expected oem pstore:<addr>:<size>", response);
+		return;
+	}
+
+	size = hextoul(end + 1, NULL);
+	if (!size) {
+		fastboot_fail("empty pstore region", response);
+		return;
+	}
+
+	gkiw_pstore_addr = addr;
+	gkiw_pstore_size = size;
+	gkiw_pstore_offset = 0;
+	gkiw_pstore_active = true;
+
+	fastboot_response(FASTBOOT_MULTIRESPONSE_START, response, NULL);
+}
+
+/**
+ * oem_pstore_next() - Send the next chunk of the pstore region
+ *
+ * @response: Pointer to fastboot response buffer
+ */
+static void oem_pstore_next(char *response)
+{
+	const u8 *base;
+	char hex[2 * GKIW_PSTORE_CHUNK + 1];
+	ulong n, i;
+
+	if (!gkiw_pstore_active) {
+		fastboot_fail("no pstore request", response);
+		return;
+	}
+
+	n = gkiw_pstore_size - gkiw_pstore_offset;
+	if (n > GKIW_PSTORE_CHUNK)
+		n = GKIW_PSTORE_CHUNK;
+
+	if (!n) {
+		gkiw_pstore_active = false;
+		fastboot_okay(NULL, response);
+		return;
+	}
+
+	base = (const u8 *)gkiw_pstore_addr + gkiw_pstore_offset;
+	for (i = 0; i < n; i++)
+		sprintf(hex + 2 * i, "%02x", base[i]);
+	hex[2 * n] = '\0';
+
+	fastboot_response("INFO", response, "%08lx:%s",
+			  gkiw_pstore_offset, hex);
+	gkiw_pstore_offset += n;
+}
+#endif
