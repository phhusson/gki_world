 #include <command.h>
+#include <cpu_func.h>
 #include <dm.h>
+#include <gkiw.h>
 #include <linux/string.h>
 #include <linux/types.h>
 #include <vsprintf.h>
 #include <wdt.h>
+#include <asm/ptrace.h>
 
 #define GKIW_WDT_DEFAULT_MS	60000
 #define GKIW_PSTORE_LINE	16
 
+#define GKIW_LOG_MAGIC		0x474c4b47 /* "GKLG" */
+
+struct gkiw_log_hdr {
+	u32 magic;
+	u32 len;
+	u32 seq;
+	u32 reserved;
+};
+
+static struct gkiw_log_hdr *gkiw_log_header(void)
+{
+	return (struct gkiw_log_hdr *)(unsigned long)CONFIG_GKIW_LOG_ADDR;
+}
+
+static char *gkiw_log_data(void)
+{
+	return (char *)gkiw_log_header() + sizeof(struct gkiw_log_hdr);
+}
+
+static u32 gkiw_log_capacity(void)
+{
+	return CONFIG_GKIW_LOG_SIZE - sizeof(struct gkiw_log_hdr);
+}
+
+static void gkiw_log_sync(void)
+{
+	flush_dcache_range(CONFIG_GKIW_LOG_ADDR,
+			   CONFIG_GKIW_LOG_ADDR + CONFIG_GKIW_LOG_SIZE);
+}
+
+/*
+ * Called from the ARM64 exception path before the register dump is printed.
+ * The region is plain RAM outside U-Boot's BSS/stack/heap and survives reset.
+ */
+void gkiw_log_crash(struct pt_regs *regs)
+{
+	struct gkiw_log_hdr *hdr = gkiw_log_header();
+	static char buf[1024];
+	u32 seq = 0;
+	int used = 0;
+	int ret;
+	int i;
+
+	if (!regs)
+		return;
+
+	if (hdr->magic == GKIW_LOG_MAGIC)
+		seq = hdr->seq;
+	seq++;
+
+	ret = snprintf(buf + used, sizeof(buf) - used,
+		       "gkiw 2ndstage crash #%u\nesr=0x%016lx elr=0x%016lx spsr=0x%016lx\n",
+		       seq, regs->esr, regs->elr, regs->spsr);
+	if (ret > 0)
+		used += ret;
+	if (used >= (int)sizeof(buf))
+		used = sizeof(buf);
+
+	for (i = 0; i < 31 && used < (int)sizeof(buf); i++) {
+		ret = snprintf(buf + used, sizeof(buf) - used,
+			       "x%-2d=0x%016lx%s", i, regs->regs[i],
+			       (i & 1) ? "\n" : " ");
+		if (ret > 0)
+			used += ret;
+	}
+	if (used >= (int)sizeof(buf))
+		used = sizeof(buf);
+
+	if (used > (int)gkiw_log_capacity())
+		used = gkiw_log_capacity();
+
+	memcpy(gkiw_log_data(), buf, used);
+	hdr->len = used;
+	hdr->seq = seq;
+	hdr->magic = GKIW_LOG_MAGIC;
+	gkiw_log_sync();
+}
+
+static int gkiw_do_log(int argc, char *const argv[])
+{
+	struct gkiw_log_hdr *hdr = gkiw_log_header();
+
+	if (argc == 2 && !strcmp(argv[1], "clear")) {
+		hdr->magic = 0;
+		gkiw_log_sync();
+		printf("gkiw: 2ndstage crash log cleared\n");
+		return 0;
+	}
+	if (argc != 1)
+		return CMD_RET_USAGE;
+
+	invalidate_dcache_range(CONFIG_GKIW_LOG_ADDR,
+				CONFIG_GKIW_LOG_ADDR + CONFIG_GKIW_LOG_SIZE);
+	if (hdr->magic != GKIW_LOG_MAGIC) {
+		printf("gkiw: no 2ndstage crash log\n");
+		return 0;
+	}
+	if (hdr->len > gkiw_log_capacity()) {
+		printf("gkiw: corrupt 2ndstage crash log (len=%u)\n", hdr->len);
+		return CMD_RET_FAILURE;
+	}
+
+	printf("%s", gkiw_log_data());
+	if (!hdr->len || gkiw_log_data()[hdr->len - 1] != '\n')
+		printf("\n");
+
+	return 0;
+}
+
 static int gkiw_wdt_get(struct udevice **dev)
 {
 	return uclass_get_device(UCLASS_WDT, 0, dev);
