@@ -296,6 +296,31 @@
 {
 }
 
+/* Board hook: read the battery voltage in microvolts. */
+int __weak gkiw_board_battery_uv(int *uv)
+{
+	return -ENOSYS;
+}
+
+static int gkiw_do_battery(int argc, char *const argv[])
+{
+	int uv;
+	int ret;
+
+	if (argc != 1)
+		return CMD_RET_USAGE;
+
+	ret = gkiw_board_battery_uv(&uv);
+	if (ret) {
+		printf("gkiw: battery read failed: %d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+
+	printf("gkiw: battery %d mV\n", (uv + 500) / 1000);
+
+	return 0;
+}
