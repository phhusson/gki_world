+
+int meson_board_late_init(void)
+{
+	char serial[SM_SERIAL_SIZE];
+	char serial_hex[2 * SM_SERIAL_SIZE + 1];
+	int i;
+
+	if (!meson_sm_get_serial(serial, sizeof(serial))) {
+		for (i = 0; i < SM_SERIAL_SIZE; i++)
+			sprintf(serial_hex + 2 * i, "%02x", serial[i]);
+		serial_hex[2 * SM_SERIAL_SIZE] = '\0';
+		env_set("serial#", serial_hex);
+	}
+
+	env_set("board", "gkiw-g12a");
+
+	return 0;
+}
