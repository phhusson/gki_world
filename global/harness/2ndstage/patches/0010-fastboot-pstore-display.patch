+#if CONFIG_IS_ENABLED(FASTBOOT_CMD_OEM_PSTORE_DISPLAY)
+#define PSTORE_DISPLAY_CHUNK	48
+#define PSTORE_DISPLAY_LINE	512
+
+static char pstore_display_buf[PSTORE_DISPLAY_LINE];
+static u32 pstore_display_off;
+static u32 pstore_display_len;
+static u32 pstore_display_line;
+static bool pstore_display_active;
+
+static void oem_pstore_display(char *cmd_parameter, char *response)
+{
+	char cmd[64];
+	const char *type = cmd_parameter ? cmd_parameter : "console";
+
+	if (!*type)
+		type = "console";
+	snprintf(cmd, sizeof(cmd), "pstore display %s", type);
+
+	console_record_reset();
+	run_command(cmd, 0);
+
+	pstore_display_off = 0;
+	pstore_display_len = 0;
+	pstore_display_line = 0;
+	pstore_display_active = true;
+	fastboot_response(FASTBOOT_MULTIRESPONSE_START, response, NULL);
+}
+
+static void oem_pstore_display_next(char *response)
+{
+	u32 n;
+	int ret;
+
+	if (!pstore_display_active) {
+		fastboot_fail("no pstore display request", response);
+		return;
+	}
+
+	while (pstore_display_off == pstore_display_len) {
+		if (console_record_isempty()) {
+			pstore_display_active = false;
+			fastboot_okay(NULL, response);
+			return;
+		}
+		ret = console_record_readline(pstore_display_buf,
+					      sizeof(pstore_display_buf));
+		if (ret < 0) {
+			pstore_display_active = false;
+			fastboot_fail("pstore display overflow", response);
+			return;
+		}
+		pstore_display_len = ret;
+		pstore_display_off = 0;
+		while (pstore_display_len > 0 &&
+		       (pstore_display_buf[pstore_display_len - 1] == '\n' ||
+			pstore_display_buf[pstore_display_len - 1] == '\r'))
+			pstore_display_len--;
+		if (pstore_display_len)
+			pstore_display_line++;
+	}
+
+	n = pstore_display_len - pstore_display_off;
+	if (n > PSTORE_DISPLAY_CHUNK)
+		n = PSTORE_DISPLAY_CHUNK;
+	fastboot_response("INFO", response, "%x:%.*s",
+			  pstore_display_line, n,
+			  pstore_display_buf + pstore_display_off);
+	pstore_display_off += n;
+}
+
+static void oem_pstore_display_console(char *p, char *response)
+{
+	oem_pstore_display("console", response);
+}
+
+static void oem_pstore_display_dmesg(char *p, char *response)
+{
+	oem_pstore_display("dmesg", response);
+}
+
+static void oem_pstore_display_pmsg(char *p, char *response)
+{
+	oem_pstore_display("pmsg", response);
+}
+
+static void oem_pstore_display_ftrace(char *p, char *response)
+{
+	oem_pstore_display("ftrace", response);
+}
+#endif
