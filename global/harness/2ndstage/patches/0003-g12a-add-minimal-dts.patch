+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * gki_world development bootloader device tree for Amlogic G12A.
+ *
+ * Deliberately minimal: UART, USB gadget and the watchdog only. No eMMC, SD,
+ * Ethernet, display, audio, PCIe or other peripherals. The first 128 MiB are
+ * treated as owned by the secure world / first stage, and only 512 MiB of RAM
+ * are assumed, so the same tree works on the smallest boards.
+ */
+
+/dts-v1/;
+
+#include "meson-g12a.dtsi"
+
+/ {
+	model = "gki_world G12A development board";
+	compatible = "gkiw,g12a", "amlogic,g12a";
+
+	aliases {
+		serial0 = &uart_AO;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x0 0x0 0x20000000>; /* 512 MiB lower bound */
+	};
+
+};
+
+/*
+ * The first stage has already configured the console pinmux. Do not
+ * re-apply u200's pins here: this board may use different pads, and
+ * re-muxing breaks RX.
+ */
+&uart_AO {
+	status = "okay";
+};
+
+&usb {
+	status = "okay";
+};
