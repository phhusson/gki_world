#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Keep the gki_world Linux watchdog alive.
#
# The phone runs a userspace watchdog owner: it resets unless it receives a
# heartbeat on the second USB ACM port.  Losing the host, the harness or the
# USB link therefore recovers the phone into the second stage by itself.
#
# With no argument the heartbeat port is found by USB interface number (the
# console is the first ACM pair, the heartbeat the second), so ttyACM numbering
# and re-enumeration do not matter.
#
# Usage: gkiw-heartbeat [/dev/ttyACMx] [interval-seconds]

set -u

DEV=${1:-}
PERIOD=${2:-1}

find_hb()
{
	for t in /dev/ttyACM*; do
		[ -e "$t" ] || continue
		link=/sys/class/tty/$(basename "$t")/device
		[ -e "$link" ] || continue
		path=$(readlink -f "$link") || continue
		intf=${path##*:1.}
		[ "$intf" != "$path" ] || continue
		if [ "$intf" -ge 2 ] 2>/dev/null; then
			DEV=$t
			return 0
		fi
	done
	return 1
}

while :; do
	if [ -z "$DEV" ]; then
		find_hb || {
			sleep 1
			continue
		}
	fi

	if exec 3> "$DEV" 2>/dev/null; then
		while :; do
			[ -e "$DEV" ] || break
			printf 'P' >&3 2>/dev/null || break
			sleep "$PERIOD"
		done
		exec 3>&-
		echo "gkiw-heartbeat: lost $DEV, waiting for it to come back" >&2
	fi

	DEV=
	sleep 1
done
