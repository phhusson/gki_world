#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Host helper for the gki_world second-stage bootloader.

Uses the stock `fastboot` client. The pstore dump rides on the multiresponse
INFO lines produced by `oem pstore:<addr>:<size>`; each line is one chunk.
"""

import argparse
import os
import re
import struct
import subprocess
import sys

INFO_RE = re.compile(r"^\(bootloader\) ([0-9a-fA-F]+):([0-9a-fA-F]+)\s*$")


def fastboot(args, serial=None):
    cmd = [os.environ.get("FASTBOOT", "fastboot")]
    if serial:
        cmd += ["-s", serial]
    cmd += args
    return subprocess.run(cmd, text=True, capture_output=True)


def cmd_boot(args):
    proc = fastboot(["boot", args.image], args.serial)
    sys.stdout.write(proc.stdout)
    sys.stderr.write(proc.stderr)
    return proc.returncode


def fetch_region(addr, size, serial=None):
    proc = fastboot(["oem", f"pstore:{addr:#x}:{size:#x}"], serial)
    output = proc.stdout + proc.stderr

    data = bytearray()
    for line in output.splitlines():
        match = INFO_RE.match(line.strip())
        if not match:
            continue
        offset = int(match.group(1), 16)
        chunk = bytes.fromhex(match.group(2))
        if offset != len(data):
            raise RuntimeError(
                f"unexpected chunk offset {offset:#x}, expected {len(data):#x}"
            )
        data += chunk

    if not data:
        raise RuntimeError(output.strip() or "no pstore data received")
    return bytes(data[:size])


def cmd_pstore(args):
    addr = int(args.addr, 0)
    size = int(args.size, 0)
    try:
        data = fetch_region(addr, size, args.serial)
    except RuntimeError as err:
        print(err, file=sys.stderr)
        return 1

    with open(args.output, "wb") as f:
        f.write(data)
    print(f"wrote {len(data)} bytes to {args.output}")
    return 0


LOG_MAGIC = 0x474C4B32


def parse_log_slot(data):
    if len(data) < 24:
        return None
    magic, head, used, cap, seq, _ = struct.unpack_from("<IIIIII", data, 0)
    if magic != LOG_MAGIC or cap == 0 or cap > len(data) - 24 or used > cap:
        return None

    start = head if used == cap else 0
    text = bytearray()
    for i in range(used):
        text.append(data[24 + (start + i) % cap])
    return seq, bytes(text)


def cmd_log(args):
    addr = int(args.addr, 0)
    size = int(args.size, 0)
    try:
        data = fetch_region(addr, size, args.serial)
    except RuntimeError as err:
        print(err, file=sys.stderr)
        return 1

    slot_size = size // 2
    slots = [data[:slot_size], data[slot_size:slot_size * 2]]
    order = [1, 0] if args.current else [0, 1]
    for index in order:
        parsed = parse_log_slot(slots[index])
        if not parsed:
            continue
        seq, text = parsed
        label = "current" if index else "previous"
        print(f"--- {label} 2ndstage log (seq {seq}) ---", file=sys.stderr)
        sys.stdout.buffer.write(text)
        if text and not text.endswith(b"\n"):
            sys.stdout.buffer.write(b"\n")
        return 0

    print("no 2ndstage log found", file=sys.stderr)
    return 1


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--serial", help="fastboot serial number")
    sub = parser.add_subparsers(dest="command", required=True)

    boot = sub.add_parser("boot", help="send an Android boot image")
    boot.add_argument("image")
    boot.set_defaults(func=cmd_boot)

    pstore = sub.add_parser("pstore", help="dump a pstore/ramoops region")
    pstore.add_argument(
        "--addr",
        default=os.environ.get("GKIW_PSTORE_ADDR", "0x1c000000"),
        help="region address (must match the ramoops DT node)",
    )
    pstore.add_argument(
        "--size",
        default=os.environ.get("GKIW_PSTORE_SIZE", "0x100000"),
        help="region size (must match the ramoops DT node)",
    )
    pstore.add_argument("-o", "--output", default="pstore.bin")
    pstore.set_defaults(func=cmd_pstore)

    log = sub.add_parser("log", help="parse the persistent 2ndstage console log")
    log.add_argument(
        "--addr",
        default=os.environ.get("GKIW_LOG_ADDR", "0x1c100000"),
        help="2ndstage log address",
    )
    log.add_argument(
        "--size",
        default=os.environ.get("GKIW_LOG_SIZE", "0x20000"),
        help="2ndstage log size (two slots)",
    )
    log.add_argument(
        "--current",
        action="store_true",
        help="show the current boot slot instead of the previous one",
    )
    log.set_defaults(func=cmd_log)

    args = parser.parse_args()
    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
