diff --git a/arch/arm64/kernel/gkiw_bringup.c b/arch/arm64/kernel/gkiw_bringup.c
new file mode 100644
index 000000000..d50157d97
--- /dev/null
+++ b/arch/arm64/kernel/gkiw_bringup.c
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * gki_world arm64 bringup breadcrumbs.
+ *
+ * A blind board has no usable serial console until the UART clock driver is
+ * ported.  Write short progress lines to a static RAM buffer inside the
+ * kernel image; the next second-stage boot uploads it over fastboot.  The
+ * buffer is in BSS, so it is mapped from the first instruction and is not
+ * handed out by the page allocator.
+ *
+ * This is a temporary bringup aid.
+ */
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/sizes.h>
+
+#define GKIW_MARK_MAGIC		0x474b4d31	/* "GKM1" */
+#define GKIW_MARK_MAX		SZ_64K
+
+struct gkiw_mark_hdr {
+	u32 magic;
+	u32 len;
+	char data[];
+};
+
+static char gkiw_mark_buf[GKIW_MARK_MAX] __aligned(4096);
+static struct gkiw_mark_hdr *gkiw_marks;
+
+/*
+ * Initialised data, so it is present in the loaded image and is not wiped by
+ * the BSS clear.  The early assembly boot path writes to this through the
+ * initial identity map.
+ */
+u32 gkiw_boot_markers[16] __aligned(8) = { 0x474b424d };
+
+void gkiw_mark_enable(void)
+{
+}
+
+void gkiw_mark(const char *s)
+{
+	struct gkiw_mark_hdr *hdr;
+
+	hdr = (struct gkiw_mark_hdr *)gkiw_mark_buf;
+	if (!gkiw_marks) {
+		hdr->magic = GKIW_MARK_MAGIC;
+		hdr->len = 0;
+		hdr->data[0] = '\0';
+		gkiw_marks = hdr;
+	}
+
+	while (*s && gkiw_marks->len < GKIW_MARK_MAX - sizeof(*hdr) - 2)
+		gkiw_marks->data[gkiw_marks->len++] = *s++;
+	gkiw_marks->data[gkiw_marks->len++] = '\n';
+	gkiw_marks->data[gkiw_marks->len] = '\0';
+}
