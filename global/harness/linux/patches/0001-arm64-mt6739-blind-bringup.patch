diff --git a/drivers/tty/serial/gkiw_earlycon.c b/drivers/tty/serial/gkiw_earlycon.c
new file mode 100644
index 000000000..fa4132094
--- /dev/null
+++ b/drivers/tty/serial/gkiw_earlycon.c
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * gki_world memory earlycon.
+ *
+ * On a blind bringup board the UART may not be wired to the host.  Keep the
+ * early console output in a static RAM buffer inside the kernel image, which
+ * the next second-stage boot uploads over fastboot.  The buffer is part of
+ * the kernel BSS: it is mapped from the first instruction, reserved from the
+ * allocator, and survives a warm reset.
+ *
+ * This is a development aid, not a production console.
+ */
+
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/serial_core.h>
+#include <linux/string.h>
+
+#define GKIW_EARLY_MAGIC	0x474b5731	/* "GKW1" */
+
+struct gkiw_early_hdr {
+	u32 magic;
+	u32 len;
+	char data[];
+};
+
+static char gkiw_early_buf[256 * 1024] __aligned(4096);
+static struct gkiw_early_hdr *gkiw_early;
+
+static void gkiw_early_write(struct console *con, const char *s, unsigned int n)
+{
+	unsigned int room;
+
+	if (!gkiw_early)
+		return;
+
+	room = sizeof(gkiw_early_buf) - sizeof(*gkiw_early) -
+	       gkiw_early->len - 1;
+	if (n > room)
+		n = room;
+	for (unsigned int i = 0; i < n; i++)
+		gkiw_early->data[gkiw_early->len + i] = s[i];
+	gkiw_early->len += n;
+	gkiw_early->data[gkiw_early->len] = '\0';
+}
+
+static int __init gkiw_early_setup(struct earlycon_device *device,
+				   const char *opt)
+{
+	gkiw_early = (struct gkiw_early_hdr *)gkiw_early_buf;
+	gkiw_early->magic = GKIW_EARLY_MAGIC;
+	gkiw_early->len = 0;
+	gkiw_early->data[0] = '\0';
+
+	device->con->write = gkiw_early_write;
+	return 0;
+}
+EARLYCON_DECLARE(gkiw, gkiw_early_setup);
+
+/* Kept for the bringup hooks; the buffer is always available now. */
+void gkiw_early_linear(void)
+{
+}
