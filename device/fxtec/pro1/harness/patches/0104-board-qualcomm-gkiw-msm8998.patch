 board/qualcomm/gkiw-msm8998/Makefile         |   2 +
 board/qualcomm/gkiw-msm8998/gkiw-msm8998.c   | 141 +++++++++++++++++++
 board/qualcomm/gkiw-msm8998/gkiw-msm8998.env |   9 ++
 lib/Kconfig                                  |   2 +-
 5 files changed, 279 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/dts/msm8998-fxtec-pro1-u-boot.dtsi
 create mode 100644 board/qualcomm/gkiw-msm8998/Makefile
 create mode 100644 board/qualcomm/gkiw-msm8998/gkiw-msm8998.c
 create mode 100644 board/qualcomm/gkiw-msm8998/gkiw-msm8998.env

diff --git a/arch/arm/dts/msm8998-fxtec-pro1-u-boot.dtsi b/arch/arm/dts/msm8998-fxtec-pro1-u-boot.dtsi
new file mode 100644
index 00000000..556884c6
--- /dev/null
+++ b/arch/arm/dts/msm8998-fxtec-pro1-u-boot.dtsi
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * U-Boot-only additions for the F(x)tec Pro1 dev second stage.
+ *
+ * The shared MSM8998 tree describes a full Linux phone.  This loader only
+ * needs the debug UART, USB2 peripheral mode, the ABL framebuffer and the
+ * regions shared with the kernel.  Heavy peripherals are disabled so their
+ * drivers do not probe before the console exists.
+ */
+
+/ {
+	/*
+	 * ABL reads this when it picks the DTB.  The stock Pro1 DTB carries
+	 * the v2.0 value; the Linux tree copied here says 0.
+	 */
+	qcom,msm-id = <0x124 0x20000>;
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * The framebuffer ABL leaves behind.  The stock DTB calls the
+		 * region splash_region@9d600000, 1080x2160 portrait.  No clock
+		 * or power-domain phandles here: ABL already turned the display
+		 * on, and U-Boot has no MSM8998 display clock driver.
+		 */
+		framebuffer0: framebuffer@9d600000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x9d600000 0x0 0x2400000>;
+			width = <1080>;
+			height = <2160>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	reserved-memory {
+		/*
+		 * Persistent 2ndstage console log.  It follows ramoops at
+		 * 0xffc00000 and must be reserved in the Linux DT as well.
+		 */
+		gkiw_log: gkiw-log@ffd00000 {
+			reg = <0x0 0xffd00000 0x0 0x20000>;
+			no-map;
+		};
+	};
+};
+
+/*
+ * ABL leaves the BLSP2 UART at the usual 19.2 MHz.  U-Boot has no MSM8998
+ * GCC clock driver, so the clock node is a stub; this property is what the
+ * serial driver uses to compute the divider.
+ */
+&blsp2_uart1 {
+	clock-frequency = <19200000>;
+};
+
+/*
+ * USB2 only.  The QMP USB3 PHY has no U-Boot driver, and the DWC3 node would
+ * otherwise try to get it as a second PHY.  qcom,select-utmi-as-pipe-clk is
+ * the same choice the OnePlus MSM8998 trees make for a USB2-only port.
+ */
+&usb3 {
+	/*
+	 * The GCC node is a clock stub, not a power-domain or reset
+	 * provider.  ABL leaves the controller powered and out of reset, and
+	 * the wrapper treats a missing reset as a hard probe failure, so drop
+	 * both properties rather than aborting USB probe.
+	 */
+	/delete-property/ power-domains;
+	/delete-property/ resets;
+	qcom,select-utmi-as-pipe-clk;
+};
+
+&usb3_dwc3 {
+	phys = <&qusb2phy>;
+	phy-names = "usb2-phy";
+	maximum-speed = "high-speed";
+	dr_mode = "peripheral";
+};
+
+&usb3phy {
+	status = "disabled";
+};
+
+&qusb2phy {
+	/* Same missing GCC reset provider; the driver tolerates it, but do
+	 * not ask for it at all. */
+	/delete-property/ resets;
+	status = "okay";
+};
+
+/* No storage or PCIe in the dev second stage. */
+&ufshc {
+	status = "disabled";
+};
+
+&ufsphy {
+	status = "disabled";
+};
+
+&sdhc2 {
+	status = "disabled";
+};
+
+&pcie0 {
+	status = "disabled";
+};
+
+&pcie_phy {
+	status = "disabled";
+};
+
+&wifi {
+	status = "disabled";
+};
+
+&blsp1_uart3 {
+	status = "disabled";
+};
+
+&blsp2_i2c1 {
+	status = "disabled";
+};
