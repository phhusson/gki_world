diff --git a/arch/arm/dts/msm8909-archos-ac50fhe.dts b/arch/arm/dts/msm8909-archos-ac50fhe.dts
new file mode 100644
index 0000000000..0617408797
--- /dev/null
+++ b/arch/arm/dts/msm8909-archos-ac50fhe.dts
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * U-Boot dev second stage for the Archos 50f Helium (AC50FHE, MSM8909).
+ *
+ * Deliberately minimal.  LK already configured the debug UART pins, the GCC
+ * clocks and the internal SNPS Femto USB PHY before chainloading this payload.
+ * The tree therefore describes only the UART, the ChipIdea USB controller, a
+ * stub GCC provider, the APCS watchdog and the memory windows shared with the
+ * next kernel.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/clock/qcom,gcc-msm8916.h>
+
+/ {
+	model = "Archos 50f Helium (AC50FHE)";
+	compatible = "archos,ac50fhe", "qcom,msm8909";
+
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial0 = &blsp1_uart2;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x80000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * The Linux DT in a later boot image must reserve the same
+		 * windows with no-map.  U-Boot's usable top is pulled below
+		 * them in dram_init().
+		 */
+		ramoops@9f000000 {
+			compatible = "ramoops";
+			reg = <0x9f000000 0x100000>;
+			record-size = <0x20000>;
+			console-size = <0x60000>;
+			ftrace-size = <0x20000>;
+			pmsg-size = <0x20000>;
+			ecc-size = <16>;
+			no-map;
+		};
+
+		gkiw_log: gkiw-log@9f100000 {
+			reg = <0x9f100000 0x20000>;
+			no-map;
+		};
+	};
+
+	wdt_clk: wdt-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		gcc: clock-controller@1800000 {
+			compatible = "qcom,gcc-msm8909";
+			reg = <0x1800000 0x80000>;
+			#clock-cells = <1>;
+		};
+
+
+		blsp1_uart2: serial@78b0000 {
+			compatible = "qcom,msm-uartdm-v1.4";
+			reg = <0x78b0000 0x200>;
+			clocks = <&gcc GCC_BLSP1_UART2_APPS_CLK>,
+				 <&gcc GCC_BLSP1_AHB_CLK>;
+			clock-names = "core", "iface";
+			/* LK programs the UART for 7.3728 MHz / 115200. */
+			clock-frequency = <7372800>;
+			bootph-all;
+			status = "okay";
+		};
+
+		/*
+		 * U-Boot's ci_udc/ehci-msm pair drives the ChipIdea core.  No
+		 * PHY phandle: the Femto PHY at 0x6c000 is inherited from LK and
+		 * this loader only resets the controller and switches it to
+		 * device mode.
+		 */
+		spmi_bus: spmi@200f000 {
+			compatible = "qcom,spmi-pmic-arb";
+			reg = <0x200f000 0x1000>,
+			      <0x2400000 0x400000>,
+			      <0x2c00000 0x400000>,
+			      <0x3800000 0x200000>,
+			      <0x200a000 0x2100>;
+			reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
+			qcom,ee = <0>;
+			qcom,channel = <0>;
+			#address-cells = <2>;
+			#size-cells = <0>;
+		};
+
+		usb: usb@78d9000 {
+			compatible = "qcom,ci-hdrc";
+			reg = <0x78d9000 0x200>, <0x78d9200 0x200>;
+			clocks = <&gcc GCC_USB_HS_AHB_CLK>,
+				 <&gcc GCC_USB_HS_SYSTEM_CLK>;
+			clock-names = "iface", "core";
+			dr_mode = "peripheral";
+			phy_type = "ulpi";
+			phys = <&usb_hs_phy>;
+			phy-names = "usb-phy";
+			bootph-all;
+			status = "okay";
+
+			ulpi {
+				usb_hs_phy: phy {
+					compatible = "qcom,usb-hs-phy-msm8916";
+					#phy-cells = <0>;
+				};
+			};
+		};
+
+
+		wdt: watchdog@b017000 {
+			compatible = "qcom,kpss-wdt";
+			reg = <0xb017000 0x1000>;
+			clocks = <&wdt_clk>;
+			status = "okay";
+		};
+	};
+};
