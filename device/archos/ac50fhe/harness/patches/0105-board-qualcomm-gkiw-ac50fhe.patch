diff --git a/include/configs/gkiw-msm8909.h b/include/configs/gkiw-msm8909.h
new file mode 100644
index 0000000000..2f7dd42f7a
--- /dev/null
+++ b/include/configs/gkiw-msm8909.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Archos 50f Helium (MSM8909) dev second stage.
+ *
+ * LK leaves the ARM generic timer running at 19.2 MHz; do not trust CNTFRQ,
+ * which the stock firmware does not program on this SoC.
+ */
+
+#ifndef __CONFIG_GKIW_MSM8909_H
+#define __CONFIG_GKIW_MSM8909_H
+
+#define CFG_SYS_BAUDRATE_TABLE	{ 115200, 230400, 460800, 921600 }
+#define CFG_SYS_HZ_CLOCK	19200000
+
+#endif /* __CONFIG_GKIW_MSM8909_H */
