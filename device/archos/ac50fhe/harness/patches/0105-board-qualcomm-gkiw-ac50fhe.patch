diff --git a/board/qualcomm/gkiw-msm8909/gkiw-msm8909.c b/board/qualcomm/gkiw-msm8909/gkiw-msm8909.c
new file mode 100644
index 0000000000..9be7624a7a
--- /dev/null
+++ b/board/qualcomm/gkiw-msm8909/gkiw-msm8909.c
@@ -0,0 +1,339 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * gki_world development second stage for the Archos 50f Helium (MSM8909).
+ */
+
+#include <asm/io.h>
+#include <dm.h>
+#include <asm/ptrace.h>
+#include <env.h>
+#include <g_dnl.h>
+#include <gkiw.h>
+#include <fastboot.h>
+#include <init.h>
+#include <lmb.h>
+#include <log.h>
+#include <linux/bitops.h>
+#include <linux/libfdt.h>
+#include <spmi/spmi.h>
+#include <linux/string.h>
+#include <linux/sizes.h>
+#include <time.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define QCOM_IMEM_RESTART_REASON	0x0860065c
+#define QCOM_RESTART_BOOTLOADER		0x77665500
+#define QCOM_RESTART_RECOVERY		0x77665502
+
+#define GKIW_DRAM_BASE			0x80000000
+#define GKIW_PSTORE_ADDR		0x9f000000
+
+#define QCOM_WDT_BASE			0xb017000
+#define QCOM_WDT_RST			0x04
+#define QCOM_WDT_EN			0x08
+#define QCOM_WDT_BARK_TIME		0x10
+#define QCOM_WDT_BITE_TIME		0x14
+
+/*
+ * GCC (global clock controller) USB clocks.  Offsets match the MSM8916
+ * compatible block; MSM8909 only differs in where GPLL0 reports lock.
+ */
+#define QCOM_GCC_BASE			0x1800000
+#define QCOM_GCC_GPLL0_VOTE		0x45000
+#define QCOM_GCC_GPLL0_STATUS		0x2101c
+#define QCOM_GCC_GPLL0_LOCKED		BIT(17)
+#define QCOM_GCC_USB_HS_BCR		0x41000
+#define QCOM_GCC_USB_HS_SYSTEM_CBCR	0x41004
+#define QCOM_GCC_USB_HS_AHB_CBCR	0x41008
+#define QCOM_GCC_USB_HS_SYSTEM_RCGR	0x41010
+#define QCOM_GCC_USB2A_PHY_BCR		0x41028
+#define QCOM_GCC_USB2A_PHY_SLEEP_CBCR	0x4102c
+
+#define QCOM_RCG_CFG_REG		0x4
+#define QCOM_RCG_M_REG			0x8
+#define QCOM_RCG_N_REG			0xc
+#define QCOM_RCG_D_REG			0x10
+#define QCOM_RCG_UPDATE			BIT(0)
+#define QCOM_CFG_SRC_GPLL0		(1 << 8)
+#define QCOM_CFG_SRC_SEL_MASK		(7 << 8)
+#define QCOM_CFG_MODE_MASK		(3 << 12)
+#define QCOM_CFG_HW_CTRL		BIT(20)
+#define QCOM_CFG_DIV_MASK		0x1f
+
+void gkiw_wdt_arm_early(unsigned int seconds);
+
+static void gkiw_wdt_disarm(void)
+{
+	writel(0, (void __iomem *)QCOM_WDT_BASE + QCOM_WDT_EN);
+}
+
+static void gkiw_delay_us(unsigned int us)
+{
+	unsigned long start = timer_get_us();
+
+	while (timer_get_us() - start < us)
+		;
+}
+
+/*
+ * LK jumps to `fastboot boot` payloads with its USB clocks and PHY still
+ * running, but runs target_usb_exit() before a normal boot from a flashed
+ * image.  The restart reason is the reliable difference between the two.
+ */
+static bool gkiw_usb_left_running(void)
+{
+	void __iomem *reason = (void __iomem *)QCOM_IMEM_RESTART_REASON;
+
+	return readl(reason) == QCOM_RESTART_BOOTLOADER;
+}
+
+void gkiw_wdt_arm_early(unsigned int seconds)
+{
+	void __iomem *wdt = (void __iomem *)QCOM_WDT_BASE;
+	u32 ticks = seconds * 32768;
+
+	writel(0, wdt + QCOM_WDT_EN);
+	writel(1, wdt + QCOM_WDT_RST);
+	writel(ticks - 32768, wdt + QCOM_WDT_BARK_TIME);
+	writel(ticks, wdt + QCOM_WDT_BITE_TIME);
+	writel(1, wdt + QCOM_WDT_EN);
+}
+
+int gkiw_usb_clock_init(void)
+{
+	void __iomem *gcc = (void __iomem *)QCOM_GCC_BASE;
+	u32 cfg;
+	int i;
+
+	if (gkiw_usb_left_running())
+		return 0;
+
+	/* GPLL0 has to be locked before its children can run. */
+	setbits_le32(gcc + QCOM_GCC_GPLL0_VOTE, BIT(0));
+	for (i = 0; i < 1000; i++) {
+		if (readl(gcc + QCOM_GCC_GPLL0_STATUS) & QCOM_GCC_GPLL0_LOCKED)
+			break;
+		gkiw_delay_us(10);
+	}
+
+	/* USB HS system clock: GPLL0 / 10 = 80 MHz. */
+	writel(0, gcc + QCOM_GCC_USB_HS_SYSTEM_RCGR + QCOM_RCG_M_REG);
+	writel(0, gcc + QCOM_GCC_USB_HS_SYSTEM_RCGR + QCOM_RCG_N_REG);
+	writel(0, gcc + QCOM_GCC_USB_HS_SYSTEM_RCGR + QCOM_RCG_D_REG);
+	cfg = readl(gcc + QCOM_GCC_USB_HS_SYSTEM_RCGR + QCOM_RCG_CFG_REG);
+	cfg &= ~(QCOM_CFG_SRC_SEL_MASK | QCOM_CFG_MODE_MASK |
+		 QCOM_CFG_HW_CTRL | QCOM_CFG_DIV_MASK);
+	cfg |= QCOM_CFG_SRC_GPLL0 | 10;
+	writel(cfg, gcc + QCOM_GCC_USB_HS_SYSTEM_RCGR + QCOM_RCG_CFG_REG);
+	setbits_le32(gcc + QCOM_GCC_USB_HS_SYSTEM_RCGR, QCOM_RCG_UPDATE);
+	for (i = 0; i < 1000; i++) {
+		if (!(readl(gcc + QCOM_GCC_USB_HS_SYSTEM_RCGR) &
+		      QCOM_RCG_UPDATE))
+			break;
+		gkiw_delay_us(10);
+	}
+
+	/* USB HS AHB/system and the USB2A PHY sleep clock. */
+	setbits_le32(gcc + QCOM_GCC_USB_HS_AHB_CBCR, BIT(0));
+	setbits_le32(gcc + QCOM_GCC_USB_HS_SYSTEM_CBCR, BIT(0));
+	setbits_le32(gcc + QCOM_GCC_USB2A_PHY_SLEEP_CBCR, BIT(0));
+
+	/* Bring the controller and the ULPI PHY out of reset. */
+	setbits_le32(gcc + QCOM_GCC_USB_HS_BCR, BIT(0));
+	setbits_le32(gcc + QCOM_GCC_USB2A_PHY_BCR, BIT(0));
+	gkiw_delay_us(1000);
+	clrbits_le32(gcc + QCOM_GCC_USB_HS_BCR, BIT(0));
+	clrbits_le32(gcc + QCOM_GCC_USB2A_PHY_BCR, BIT(0));
+	gkiw_delay_us(1000);
+
+	return 0;
+}
+
+int arch_cpu_init(void)
+{
+	gkiw_wdt_arm_early(25);
+	return 0;
+}
+
+int mach_cpu_init(void)
+{
+	return 0;
+}
+
+int board_early_init_f(void)
+{
+	return 0;
+}
+
+int board_init(void)
+{
+	return 0;
+}
+
+int dram_init(void)
+{
+	gd->ram_base = GKIW_DRAM_BASE;
+	gd->ram_size = GKIW_PSTORE_ADDR - GKIW_DRAM_BASE;
+	return 0;
+}
+
+int dram_init_banksize(void)
+{
+	gd->dram[0].start = GKIW_DRAM_BASE;
+	gd->dram[0].size = GKIW_PSTORE_ADDR - GKIW_DRAM_BASE;
+	return 0;
+}
+
+/*
+ * LK passes the factory serial in the kernel command line as
+ * androidboot.serialno=.  Use it for the USB gadget instead of the static
+ * placeholder in the environment.  If it is missing, fall back to a
+ * CPU-derived identifier.
+ */
+#define GKIW_PRIOR_FDT_ADDR	0x90000000UL
+
+/*
+ * LK passes the patched QCDT FDT in r2.  The first-stage start code saves
+ * that pointer at GKIW_PRIOR_FDT_ADDR; /chosen/bootargs carries the factory
+ * serial number as androidboot.serialno=.
+ */
+static void gkiw_set_usb_serial(void)
+{
+	const void *fdt = (const void *)readl((void __iomem *)GKIW_PRIOR_FDT_ADDR);
+	const char *bootargs = NULL;
+	const char *p;
+	char serial[32];
+	size_t len;
+	u32 midr;
+
+	if ((unsigned long)fdt >= 0x80000000UL &&
+	    (unsigned long)fdt < 0x9f000000UL &&
+	    !((unsigned long)fdt & 3) && !fdt_check_header(fdt)) {
+		int off = fdt_path_offset(fdt, "/chosen");
+
+		if (off >= 0)
+			bootargs = fdt_getprop(fdt, off, "bootargs", NULL);
+	}
+
+	if (bootargs) {
+		p = strstr(bootargs, "androidboot.serialno=");
+		if (p) {
+			p += strlen("androidboot.serialno=");
+			len = strcspn(p, " ");
+			if (len && len < sizeof(serial)) {
+				memcpy(serial, p, len);
+				serial[len] = '\0';
+				env_set("serial#", serial);
+				printf("gkiw: serial#=%s (prior fdt)\n", serial);
+				return;
+			}
+		}
+	}
+
+	/* Not unique per device, but better than a hardcoded board name. */
+	asm volatile("mrc p15, 0, %0, c0, c0, 0" : "=r"(midr));
+	snprintf(serial, sizeof(serial), "msm8909-%08x", midr);
+	env_set("serial#", serial);
+	printf("gkiw: serial#=%s (fallback)\n", serial);
+}
+
+/*
+ * LK leaves the PM8909 LPG/PWM driving the panel backlight.  U-Boot's
+ * fastboot session can last a long time, so switch the LPG output off.
+ * PMIC USID 1, LPG channel 0 base 0xbc00.
+ */
+static void gkiw_backlight_off(void)
+{
+	struct udevice *bus;
+
+	if (uclass_get_device(UCLASS_SPMI, 0, &bus)) {
+		printf("gkiw: SPMI unavailable, backlight left on\n");
+		return;
+	}
+
+	spmi_reg_write(bus, 1, 0xbc, 0x46, 0);	/* PWM_ENABLE_CONTROL */
+	spmi_reg_write(bus, 1, 0xbc, 0x44, 0);	/* PWM_VALUE low */
+	spmi_reg_write(bus, 1, 0xbc, 0x45, 0);	/* PWM_VALUE high */
+	printf("gkiw: backlight off\n");
+}
+
+/*
+ * PMIC PON watchdog (independent of the APCS one).  Arm it just before
+ * booting a downloaded OS; the Linux pm8916_wdt driver takes it over and
+ * pings it, so a hung kernel still gets a warm reset.
+ * PON base 0x800 on PMIC USID 0.
+ */
+void gkiw_board_preboot(void)
+{
+	struct udevice *bus;
+
+	if (uclass_get_device(UCLASS_SPMI, 0, &bus)) {
+		printf("gkiw: SPMI unavailable, PMIC watchdog not armed\n");
+		return;
+	}
+
+	spmi_reg_write(bus, 0, 0x8, 0x54, 60);	/* S1 timer, seconds */
+	spmi_reg_write(bus, 0, 0x8, 0x55, 0);	/* S2 timer */
+	spmi_reg_write(bus, 0, 0x8, 0x56, 0x01);/* warm reset type */
+	spmi_reg_write(bus, 0, 0x8, 0x57, 0x80);/* S2 reset enable */
+	spmi_reg_write(bus, 0, 0x8, 0x58, 0x01);/* pet */
+	printf("gkiw: PMIC watchdog armed for 60s\n");
+}
+
+int board_late_init(void)
+{
+	gkiw_set_usb_serial();
+	gkiw_usb_clock_init();
+	gkiw_backlight_off();
+
+#if CONFIG_IS_ENABLED(FASTBOOT)
+	phys_addr_t addr = CONFIG_FASTBOOT_BUF_ADDR;
+
+	if (lmb_alloc_mem(LMB_MEM_ALLOC_ADDR, 0, &addr,
+			  CONFIG_FASTBOOT_BUF_SIZE, LMB_NONE)) {
+		log_err("%s: cannot reserve fastboot buffer\n", __func__);
+		return 0;
+	}
+	env_set_hex("fastboot_addr_r", addr);
+	env_set_hex("loadaddr", addr);
+#endif
+	/*
+	 * Early boot is over and the USB gadget is about to take over; an
+	 * unattended APCS watchdog would reset the board mid-fastboot.
+	 */
+	gkiw_wdt_disarm();
+	return 0;
+}
+
+/*
+ * The generic implementation returns -EOPNOTSUPP, which fastboot interprets
+ * as "no cable" and immediately unregisters the gadget.  This board is a
+ * development target always reached over USB.
+ */
+int g_dnl_board_usb_cable_connected(void)
+{
+	return 1;
+}
+
+int fastboot_set_reboot_flag(enum fastboot_reboot_reason reason)
+{
+	void __iomem *restart_reason = (void __iomem *)QCOM_IMEM_RESTART_REASON;
+	u32 value;
+
+	switch (reason) {
+	case FASTBOOT_REBOOT_REASON_BOOTLOADER:
+	case FASTBOOT_REBOOT_REASON_FASTBOOTD:
+		value = QCOM_RESTART_BOOTLOADER;
+		break;
+	case FASTBOOT_REBOOT_REASON_RECOVERY:
+		value = QCOM_RESTART_RECOVERY;
+		break;
+	default:
+		return 0;
+	}
+
+	writel(value, restart_reason);
+	readl(restart_reason);
+	return 0;
+}
