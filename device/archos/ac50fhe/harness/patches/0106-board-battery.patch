--- a/board/qualcomm/gkiw-msm8909/gkiw-msm8909.c
+++ b/board/qualcomm/gkiw-msm8909/gkiw-msm8909.c
@@ -281,12 +281,212 @@
 	printf("gkiw: PMIC watchdog armed for 60s\n");
 }
 
+/*
+ * PM8909 VADC on SPMI USID 0, peripheral 0x31.  PM8916/PM8909 use the older
+ * VADC register map (not ADC5): VBAT_SNS is channel 0x06 with a 1/3 prescaler.
+ * The absolute calibration is taken from the internal 625 mV and 1.25 V
+ * reference channels, like the Linux qcom-spmi-vadc driver does.
+ */
+#define QCOM_PMIC_USID			0
+#define QCOM_ADC_PID			0x31
+#define QCOM_ADC_PERPH_TYPE		0x04
+#define QCOM_ADC_PERPH_SUBTYPE		0x05
+#define QCOM_ADC_PERPH_TYPE_VADC	8
+
+#define QCOM_ADC_STATUS1		0x08
+#define QCOM_ADC_STATUS1_MASK		0x3
+#define QCOM_ADC_STATUS1_EOC		0x1
+
+#define QCOM_ADC_MODE_CTL		0x40
+#define QCOM_ADC_OP_MODE_NORMAL		0x0
+#define QCOM_ADC_OP_MODE_SHIFT		3
+#define QCOM_ADC_AMUX_TRIM_EN		BIT(1)
+#define QCOM_ADC_ADC_TRIM_EN		BIT(0)
+#define QCOM_ADC_EN_CTL1		0x46
+#define QCOM_ADC_EN			BIT(7)
+#define QCOM_ADC_CH_SEL_CTL		0x48
+#define QCOM_ADC_DIG_PARAM		0x50
+#define QCOM_ADC_HW_SETTLE_DELAY	0x51
+#define QCOM_ADC_CONV_REQ		0x52
+#define QCOM_ADC_CONV_REQ_SET		BIT(7)
+#define QCOM_ADC_FAST_AVG_CTL		0x5a
+#define QCOM_ADC_FAST_AVG_EN		0x5b
+#define QCOM_ADC_FAST_AVG_EN_SET	BIT(7)
+#define QCOM_ADC_DATA			0x60
+
+#define QCOM_ADC_CH_VBAT_SNS		0x06
+#define QCOM_ADC_CH_REF_625MV		0x09
+#define QCOM_ADC_CH_REF_1250MV		0x0a
+
+#define QCOM_ADC_VBAT_PRESCALE		3
+#define QCOM_ADC_ABS_RANGE_UV		625000
+#define QCOM_ADC_NOMINAL_FULL_SCALE_UV	1800000
+#define QCOM_ADC_NOMINAL_FULL_SCALE_CODE 0x7fff
+
+#define QCOM_ADC_CONV_RETRIES		400
+#define QCOM_ADC_CONV_DELAY_US		500
+
+static int gkiw_pmic_read(struct udevice *bus, u8 pid, u8 reg, u8 *val)
+{
+	int ret = spmi_reg_read(bus, QCOM_PMIC_USID, pid, reg);
+
+	if (ret < 0)
+		return ret;
+	*val = ret;
+	return 0;
+}
+
+static int gkiw_adc_read(struct udevice *bus, u8 reg, u8 *val)
+{
+	return gkiw_pmic_read(bus, QCOM_ADC_PID, reg, val);
+}
+
+static int gkiw_adc_write(struct udevice *bus, u8 reg, u8 val)
+{
+	return spmi_reg_write(bus, QCOM_PMIC_USID, QCOM_ADC_PID, reg, val);
+}
+
+static int gkiw_adc_convert(struct udevice *bus, u8 channel, u16 *code)
+{
+	u8 lo, hi, status;
+	int ret, i;
+
+	ret = gkiw_adc_write(bus, QCOM_ADC_MODE_CTL,
+			     (QCOM_ADC_OP_MODE_NORMAL << QCOM_ADC_OP_MODE_SHIFT) |
+			     QCOM_ADC_ADC_TRIM_EN | QCOM_ADC_AMUX_TRIM_EN);
+	if (ret)
+		return ret;
+	ret = gkiw_adc_write(bus, QCOM_ADC_CH_SEL_CTL, channel);
+	if (ret)
+		return ret;
+	ret = gkiw_adc_write(bus, QCOM_ADC_DIG_PARAM, 0);	/* 512 samples */
+	if (ret)
+		return ret;
+	ret = gkiw_adc_write(bus, QCOM_ADC_HW_SETTLE_DELAY, 0);
+	if (ret)
+		return ret;
+	ret = gkiw_adc_write(bus, QCOM_ADC_FAST_AVG_CTL, 0);
+	if (ret)
+		return ret;
+	ret = gkiw_adc_write(bus, QCOM_ADC_FAST_AVG_EN, 0);
+	if (ret)
+		return ret;
+	ret = gkiw_adc_write(bus, QCOM_ADC_EN_CTL1, QCOM_ADC_EN);
+	if (ret)
+		return ret;
+	ret = gkiw_adc_write(bus, QCOM_ADC_CONV_REQ, QCOM_ADC_CONV_REQ_SET);
+	if (ret)
+		goto out;
+
+	for (i = 0; i < QCOM_ADC_CONV_RETRIES; i++) {
+		ret = gkiw_adc_read(bus, QCOM_ADC_STATUS1, &status);
+		if (ret)
+			goto out;
+		if ((status & QCOM_ADC_STATUS1_MASK) == QCOM_ADC_STATUS1_EOC)
+			break;
+		gkiw_delay_us(QCOM_ADC_CONV_DELAY_US);
+	}
+	if (i == QCOM_ADC_CONV_RETRIES) {
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+
+	ret = gkiw_adc_read(bus, QCOM_ADC_DATA, &lo);
+	if (ret)
+		goto out;
+	ret = gkiw_adc_read(bus, QCOM_ADC_DATA + 1, &hi);
+	if (ret)
+		goto out;
+	*code = ((u16)hi << 8) | lo;
+
+out:
+	gkiw_adc_write(bus, QCOM_ADC_EN_CTL1, 0);
+	return ret;
+}
+
+int gkiw_board_battery_uv(int *uv)
+{
+	struct udevice *bus;
+	u8 type, subtype;
+	u16 ref1, ref625, code;
+	s32 mv;
+	int ret;
+
+	if (uclass_get_device(UCLASS_SPMI, 0, &bus)) {
+		printf("gkiw: battery: no SPMI bus\n");
+		return -ENODEV;
+	}
+
+	ret = gkiw_adc_read(bus, QCOM_ADC_PERPH_TYPE, &type);
+	if (ret)
+		return ret;
+	ret = gkiw_adc_read(bus, QCOM_ADC_PERPH_SUBTYPE, &subtype);
+	if (ret)
+		return ret;
+	if (type != QCOM_ADC_PERPH_TYPE_VADC) {
+		u8 pon_type = 0, pon_sub = 0, pid, t;
+
+		gkiw_pmic_read(bus, 0x08, QCOM_ADC_PERPH_TYPE, &pon_type);
+		gkiw_pmic_read(bus, 0x08, QCOM_ADC_PERPH_SUBTYPE, &pon_sub);
+		printf("gkiw: battery: peripheral 0x%02x is %u/%u (pon %u/%u)\n",
+		       QCOM_ADC_PID, type, subtype, pon_type, pon_sub);
+		for (pid = 0; pid < 0x40; pid++) {
+			if (!gkiw_pmic_read(bus, pid, QCOM_ADC_PERPH_TYPE, &t) &&
+			    t == QCOM_ADC_PERPH_TYPE_VADC)
+				printf("gkiw: battery: VADC-like block at 0x%02x\n",
+				       pid);
+		}
+		return -ENODEV;
+	}
+
+	ret = gkiw_adc_convert(bus, QCOM_ADC_CH_REF_1250MV, &ref1);
+	if (ret)
+		return ret;
+	ret = gkiw_adc_convert(bus, QCOM_ADC_CH_REF_625MV, &ref625);
+	if (ret)
+		return ret;
+	ret = gkiw_adc_convert(bus, QCOM_ADC_CH_VBAT_SNS, &code);
+	if (ret)
+		return ret;
+
+	/* Work in millivolts so the 32-bit ARM build needs no 64-bit div. */
+	if (ref1 > ref625) {
+		s32 delta = (s32)code - (s32)ref625;
+
+		if (delta < 0)
+			delta = 0;
+		mv = delta * (QCOM_ADC_ABS_RANGE_UV / 1000) / (ref1 - ref625) +
+		     QCOM_ADC_ABS_RANGE_UV / 1000;
+	} else {
+		/* Nominal 1.8 V full scale if the references are unusable. */
+		printf("gkiw: battery: bad refs %u/%u, using nominal\n",
+		       ref1, ref625);
+		mv = (s32)code * (QCOM_ADC_NOMINAL_FULL_SCALE_UV / 1000) /
+		     QCOM_ADC_NOMINAL_FULL_SCALE_CODE;
+	}
+	if (mv < 0)
+		mv = 0;
+
+	*uv = mv * 1000 * QCOM_ADC_VBAT_PRESCALE;
+
+	return 0;
+}
+
 int board_late_init(void)
 {
+	int uv;
+	int ret;
+
 	gkiw_set_usb_serial();
 	gkiw_usb_clock_init();
 	gkiw_backlight_off();
 
+	ret = gkiw_board_battery_uv(&uv);
+	if (!ret)
+		printf("gkiw: battery %d mV\n", (uv + 500) / 1000);
+	else
+		printf("gkiw: battery read failed (%d)\n", ret);
+
 #if CONFIG_IS_ENABLED(FASTBOOT)
 	phys_addr_t addr = CONFIG_FASTBOOT_BUF_ADDR;
 
