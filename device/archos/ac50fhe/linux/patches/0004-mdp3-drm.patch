@@ -0,0 +1,13 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config DRM_MDP3
+	tristate "Qualcomm MDP3 display controller"
+	depends on DRM && OF && COMMON_CLK
+	select DRM_KMS_HELPER
+	select DRM_GEM_DMA_HELPER
+	help
+	  DRM/KMS driver for the Qualcomm MDP3 display controller found on
+	  MSM8909.  It takes over the primary DMA programmed by the bootloader
+	  and supports dumb buffers and page flips on the fixed panel mode.
+
+	  The DSI controller, PHY and panel are still set up by the bootloader;
+	  this driver does not implement modesetting yet.
