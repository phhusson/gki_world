diff --git a/drivers/iio/light/em3071x.c b/drivers/iio/light/em3071x.c
new file mode 100644
index 000000000..809852ce4
--- /dev/null
+++ b/drivers/iio/light/em3071x.c
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Epticore EM3071x ambient light sensor.
+ *
+ * Minimal ALS-only IIO driver derived from the vendor driver's register use:
+ * chip ID register 0 returns 0x31, ALS data is a 12-bit count split over
+ * registers 9 (low byte) and 10 (high nibble).  The vendor configures the
+ * part with the init table below and writes 5/0xf0/0xff to start a
+ * measurement before each read.
+ *
+ * The lux conversion is the vendor's nominal raw * 10; it is not calibrated.
+ */
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#include <linux/iio/iio.h>
+
+#define EM3071X_CHIP_ID		0x00
+#define EM3071X_CHIP_ID_VAL	0x31
+#define EM3071X_ALS_DATA0	0x09
+#define EM3071X_ALS_DATA1	0x0a
+
+struct em3071x_data {
+	struct i2c_client *client;
+	struct regulator *vdd;
+	struct regulator *vddio;
+};
+
+static int em3071x_read_byte(struct em3071x_data *data, u8 reg)
+{
+	int ret = i2c_smbus_read_word_data(data->client, reg);
+
+	if (ret < 0)
+		return ret;
+	return ret & 0xff;
+}
+
+static int em3071x_write_byte(struct em3071x_data *data, u8 reg, u8 val)
+{
+	return i2c_smbus_write_byte_data(data->client, reg, val);
+}
+
+static int em3071x_init(struct em3071x_data *data)
+{
+	static const u8 init[][2] = {
+		{ 0x01, 0xae }, { 0x02, 0x00 }, { 0x03, 0x00 },
+		{ 0x04, 0xff }, { 0x05, 0x00 }, { 0x06, 0x00 },
+		{ 0x07, 0xff },
+	};
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(init); i++) {
+		ret = em3071x_write_byte(data, init[i][0], init[i][1]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int em3071x_read_raw(struct iio_dev *indio_dev,
+			    struct iio_chan_spec const *chan,
+			    int *val, int *val2, long mask)
+{
+	struct em3071x_data *data = iio_priv(indio_dev);
+	int lo, hi, ret;
+
+	ret = em3071x_write_byte(data, 0x05, 0x05);
+	if (ret)
+		return ret;
+	ret = em3071x_write_byte(data, 0x06, 0xf0);
+	if (ret)
+		return ret;
+	ret = em3071x_write_byte(data, 0x07, 0xff);
+	if (ret)
+		return ret;
+
+	msleep(20);
+
+	lo = em3071x_read_byte(data, EM3071X_ALS_DATA0);
+	if (lo < 0)
+		return lo;
+	hi = em3071x_read_byte(data, EM3071X_ALS_DATA1);
+	if (hi < 0)
+		return hi;
+
+	switch (mask) {
+	case IIO_CHAN_INFO_RAW:
+		*val = (lo & 0xff) | ((hi & 0x0f) << 8);
+		return IIO_VAL_INT;
+	case IIO_CHAN_INFO_PROCESSED:
+		*val = ((lo & 0xff) | ((hi & 0x0f) << 8)) * 10;
+		return IIO_VAL_INT;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct iio_info em3071x_info = {
+	.read_raw = em3071x_read_raw,
+};
+
+static const struct iio_chan_spec em3071x_channels[] = {
+	{
+		.type = IIO_LIGHT,
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW) |
+				      BIT(IIO_CHAN_INFO_PROCESSED),
+	},
+};
+
+static int em3071x_probe(struct i2c_client *client)
+{
+	struct em3071x_data *data;
+	struct iio_dev *indio_dev;
+	int ret;
+
+	indio_dev = devm_iio_device_alloc(&client->dev, sizeof(*data));
+	if (!indio_dev)
+		return -ENOMEM;
+
+	data = iio_priv(indio_dev);
+	data->client = client;
+	i2c_set_clientdata(client, indio_dev);
+
+	data->vdd = devm_regulator_get_optional(&client->dev, "vdd");
+	if (IS_ERR(data->vdd))
+		return dev_err_probe(&client->dev, PTR_ERR(data->vdd),
+				     "failed to get vdd\n");
+	data->vddio = devm_regulator_get_optional(&client->dev, "vddio");
+	if (IS_ERR(data->vddio))
+		return dev_err_probe(&client->dev, PTR_ERR(data->vddio),
+				     "failed to get vddio\n");
+
+	ret = regulator_enable(data->vdd);
+	if (ret)
+		return ret;
+	ret = regulator_enable(data->vddio);
+	if (ret)
+		return ret;
+	msleep(20);
+
+	ret = em3071x_read_byte(data, EM3071X_CHIP_ID);
+	if (ret < 0)
+		return ret;
+	if (ret != EM3071X_CHIP_ID_VAL)
+		return dev_err_probe(&client->dev, -ENODEV,
+				     "unexpected chip ID 0x%02x\n", ret);
+
+	ret = em3071x_init(data);
+	if (ret)
+		return ret;
+
+	indio_dev->name = "em3071x";
+	indio_dev->info = &em3071x_info;
+	indio_dev->channels = em3071x_channels;
+	indio_dev->num_channels = ARRAY_SIZE(em3071x_channels);
+	indio_dev->modes = INDIO_DIRECT_MODE;
+
+	return devm_iio_device_register(&client->dev, indio_dev);
+}
+
+static const struct of_device_id em3071x_of_match[] = {
+	{ .compatible = "epticore,em3071x" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, em3071x_of_match);
+
+static const struct i2c_device_id em3071x_id[] = {
+	{ "em3071x" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, em3071x_id);
+
+static struct i2c_driver em3071x_driver = {
+	.driver = {
+		.name = "em3071x",
+		.of_match_table = em3071x_of_match,
+	},
+	.probe = em3071x_probe,
+	.id_table = em3071x_id,
+};
+module_i2c_driver(em3071x_driver);
+
+MODULE_DESCRIPTION("Epticore EM3071x ambient light sensor");
+MODULE_LICENSE("GPL");
