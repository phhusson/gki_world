# UART console + USB fastboot gadget only.
#
# Minimal devicetree: no eMMC/SD, Ethernet, display, audio, PCIe or USB3 host.
# Only 512 MiB of RAM are assumed, and the first 128 MiB are reserved for the
# secure world / first stage.

CONFIG_DEFAULT_DEVICE_TREE="amlogic/meson-g12a-gkiw"

# The boot.img carries a 4 KiB ARM64 Image header in front of U-Boot, so the
# payload itself starts at 0x08001000. 0x08000000 is above the low 128 MiB
# reserved for the secure world/first stage, and away from the vendor DTB at
# 0x01000000 and its Android image at 0x03080000.
CONFIG_TEXT_BASE=0x08001000
CONFIG_POSITION_INDEPENDENT=y
# The dev bootloader runs from a fixed 512 MiB window and does not relocate.
CONFIG_SKIP_RELOCATE=y

CONFIG_CMD_FASTBOOT=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT_BUF_ADDR=0x10000000
CONFIG_FASTBOOT_BUF_SIZE=0x08000000
CONFIG_FASTBOOT_CMD_OEM_PSTORE=y
CONFIG_CMD_GKIW=y
CONFIG_ANDROID_BOOT_IMAGE=y
CONFIG_CMD_BOOTM=y

CONFIG_WDT=y
CONFIG_WDT_MESON_GXBB=y
CONFIG_CMD_WDT=y
# Service the watchdog while waiting in fastboot; servicing stops when U-Boot
# jumps to Linux.
CONFIG_WATCHDOG=y
CONFIG_GKIW_LOG_ADDR=0x1c100000
CONFIG_GKIW_LOG_SIZE=0x10000
CONFIG_CONSOLE_RECORD=y
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x20000
CONFIG_FASTBOOT_REBOOT=y

# The DWC2 gadget sits under the Meson USB glue node; the glue driver is
# required to bind the parent and bring up the PHYs.
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_MESON_G12A=y
# CONFIG_USB_DWC3_GADGET is not set

# Everything else the u200 reference build pulls in.
# CONFIG_MMC is not set
# CONFIG_CMD_MMC is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_XHCI_DWC3 is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_VIDEO is not set

# No network: UART + USB gadget only.
# CONFIG_MISC_INIT_R is not set
# CONFIG_NET is not set
# CONFIG_DM_ETH is not set
# CONFIG_CMD_NET is not set
# CONFIG_ETH_DESIGNWARE is not set
# CONFIG_MDIO_MUX_MESON_G12A is not set

CONFIG_BOOTCOMMAND="fastboot usb 0"
CONFIG_BOOTDELAY=1

# OpenSSL 4 removed the ENGINE API used by U-Boot's host signing tools.
# This bootloader boots unsigned Android images and does not need them.
# CONFIG_TOOLS_KWBIMAGE is not set
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_FIT_SIGNATURE is not set
