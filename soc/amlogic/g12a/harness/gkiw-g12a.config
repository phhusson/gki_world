# UART console + USB fastboot gadget only.
#
# Derived from u200_defconfig (the S905X2 reference board). The fastboot
# buffer sits below the pstore region and away from U-Boot's stack.

CONFIG_CMD_FASTBOOT=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT_BUF_ADDR=0x21000000
CONFIG_FASTBOOT_BUF_SIZE=0x10000000
CONFIG_FASTBOOT_CMD_OEM_PSTORE=y
CONFIG_CMD_GKIW=y
CONFIG_ANDROID_BOOT_IMAGE=y
CONFIG_CMD_BOOTM=y

CONFIG_WDT=y
CONFIG_WDT_MESON_GXBB=y
CONFIG_CMD_WDT=y

CONFIG_BOOTCOMMAND="fastboot usb 0"
CONFIG_BOOTDELAY=1

# OpenSSL 4 removed the ENGINE API used by U-Boot's host signing tools.
# This bootloader boots unsigned Android images and does not need them.
# CONFIG_TOOLS_KWBIMAGE is not set
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_FIT_SIGNATURE is not set
