diff --git a/arch/arm/mach-meson/board-g12a.c b/arch/arm/mach-meson/board-g12a.c
index 17722cb8..8638e119 100644
--- a/arch/arm/mach-meson/board-g12a.c
+++ b/arch/arm/mach-meson/board-g12a.c
@@ -60,6 +60,15 @@ void meson_init_reserved_memory(void *fdt)
 
 phys_size_t get_effective_memsize(void)
 {
+	if (IS_ENABLED(CONFIG_CMD_GKIW)) {
+		/*
+		 * gki_world dev bootloader: the secure register is not reliable
+		 * when this U-Boot is chainloaded as a second stage. Assume the
+		 * same 512 MiB floor as the minimal devicetree.
+		 */
+		return SZ_512M;
+	}
+
 	/* Size is reported in MiB, convert it in bytes */
 	return min(((readl(G12A_AO_SEC_GP_CFG0) & G12A_AO_MEM_SIZE_MASK)
 			>> G12A_AO_MEM_SIZE_SHIFT) * SZ_1M, 0xf5000000);
