# Qualcomm MSM8998 dev second stage: UART, USB fastboot and pstore.
#
# This fragment is merged after qcom_defconfig and qcom-phone.config.  It
# keeps the phone-common settings that are useful (panic hang, console
# record) and removes storage, PCIe, PMIC and button probing that the
# second stage does not need.

CONFIG_DEFAULT_DEVICE_TREE="qcom/msm8998-fxtec-pro1"
CONFIG_SYS_BOARD="gkiw-msm8998"
CONFIG_SYS_VENDOR="qualcomm"
CONFIG_SYS_CONFIG_NAME="qcom"
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/gkiw-msm8998/gkiw-msm8998.env"

# Fixed buffer below 4 GiB.  The board file reserves it in LMB as well.
CONFIG_FASTBOOT_BUF_ADDR=0xa0000000
CONFIG_FASTBOOT_BUF_SIZE=0x08000000
CONFIG_FASTBOOT_CMD_OEM_PSTORE=y
CONFIG_CMD_GKIW=y
CONFIG_ANDROID_BOOT_IMAGE=y
CONFIG_CMD_BOOTM=y
CONFIG_CMD_FASTBOOT=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_DM_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GENERIC=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_PHY=y
CONFIG_PHY_QCOM_QUSB2=y

CONFIG_GKIW_LOG_ADDR=0xffd00000
CONFIG_GKIW_LOG_SIZE=0x20000
CONFIG_CONSOLE_RECORD=y
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x100000
CONFIG_FASTBOOT_REBOOT=y
CONFIG_FASTBOOT_CMD_OEM_PSTORE_DISPLAY=y
CONFIG_SILENT_CONSOLE=y

# U-Boot's ramoops decoder.  These sizes match the Pro1 mainline DT and
# must stay in step with it.
CONFIG_CMD_PSTORE=y
CONFIG_CMD_PSTORE_MEM_ADDR=0xffc00000
CONFIG_CMD_PSTORE_MEM_SIZE=0x100000
CONFIG_CMD_PSTORE_RECORD_SIZE=0x10000
CONFIG_CMD_PSTORE_CONSOLE_SIZE=0x60000
CONFIG_CMD_PSTORE_FTRACE_SIZE=0x10000
CONFIG_CMD_PSTORE_PMSG_SIZE=0x20000
CONFIG_CMD_PSTORE_ECC_SIZE=16

CONFIG_BOOTDELAY=1
# There is no storage to scan before boot.
# CONFIG_USE_PREBOOT is not set

CONFIG_VIDEO=y
CONFIG_VIDEO_SIMPLE=y
CONFIG_VIDEO_FONT_16X32=y
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_MSM_SERIAL=y

# Keep the dev second stage off storage, PCIe, PMIC and buttons.
# CONFIG_MMC is not set
# CONFIG_CMD_MMC is not set
# CONFIG_MMC_SDHCI is not set
# CONFIG_MMC_SDHCI_MSM is not set
# CONFIG_SCSI is not set
# CONFIG_CMD_SCSI is not set
# CONFIG_UFS is not set
# CONFIG_UFS_QCOM is not set
# CONFIG_CMD_UFS is not set
# CONFIG_PHY_QCOM_QMP_UFS is not set
# CONFIG_PHY_QCOM_QMP_COMBO is not set
# CONFIG_PHY_QCOM_QMP_PCIE is not set
# CONFIG_SPMI_MSM is not set
# CONFIG_DM_PMIC is not set
# CONFIG_PMIC_QCOM is not set
# CONFIG_DM_REGULATOR is not set
# CONFIG_DM_REGULATOR_QCOM_RPMH is not set
# CONFIG_BUTTON_CMD is not set
# CONFIG_BUTTON_KEYBOARD is not set
# CONFIG_BUTTON_QCOM_PMIC is not set
# CONFIG_BUTTON_REMAP_PHONE_KEYS is not set
# CONFIG_USB_FUNCTION_ACM is not set
# CONFIG_FASTBOOT_FLASH is not set
# CONFIG_DFU_MMC is not set
# CONFIG_DFU_SCSI is not set
# CONFIG_CMD_DFU is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_CMD_UMS_ABORT_KEYED is not set
# CONFIG_CMD_FASTBOOT_ABORT_KEYED is not set
# CONFIG_RNG_MSM is not set
# CONFIG_QCOM_HYP_SMMU is not set
# CONFIG_IOMMU is not set
# CONFIG_INTERCONNECT is not set
# CONFIG_QCOM_RPMH is not set
# CONFIG_QCOM_COMMAND_DB is not set
# CONFIG_QCOM_RPMH_POWER_DOMAIN is not set

# OpenSSL 4 removed the ENGINE API used by U-Boot's host signing tools.
# CONFIG_TOOLS_KWBIMAGE is not set
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_FIT_SIGNATURE is not set
