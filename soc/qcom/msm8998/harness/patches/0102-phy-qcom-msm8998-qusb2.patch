From 54eaffa8f49808fc04ab86eae330957476fd192b Mon Sep 17 00:00:00 2001
From: Pierre-Hugues Husson <phh@phh.me>
Date: Thu, 26 Nov 2026 19:06:16 +0100
Subject: [PATCH 2/3] phy: qcom: add the MSM8998 QUSB2 PHY

Add the MSM8998 register layout, init table and config from the Linux
qusb2 PHY driver, and match the qcom,msm8998-qusb2-phy compatible.

The reset provider is the MSM8998 GCC, which this tree only has as a
clock stub.  ABL leaves the PHY out of reset, so treat a missing reset
as non-fatal instead of failing the probe.  Also bring the core PLL out
of reset when the variant has the override register, as Linux does.
---
 drivers/phy/qcom/phy-qcom-qusb2.c | 64 ++++++++++++++++++++++++++++++-
 1 file changed, 62 insertions(+), 2 deletions(-)

diff --git a/drivers/phy/qcom/phy-qcom-qusb2.c b/drivers/phy/qcom/phy-qcom-qusb2.c
index 6278171b..5d27bf89 100644
--- a/drivers/phy/qcom/phy-qcom-qusb2.c
+++ b/drivers/phy/qcom/phy-qcom-qusb2.c
@@ -236,6 +236,36 @@ static const struct qusb2_phy_init_tbl qusb2_v2_init_tbl[] = {
 	QUSB2_PHY_INIT_CFG(QUSB2PHY_CHG_CTRL2, 0x0),
 };
 
+/*
+ * MSM8998 has its own register layout and init table.  Values are from the
+ * Linux qusb2 PHY driver (msm8998_phy_cfg); the U-Boot driver has no other
+ * source for this SoC.
+ */
+static const unsigned int msm8998_regs_layout[] = {
+	[QUSB2PHY_PLL_CORE_INPUT_OVERRIDE] = 0xa8,
+	[QUSB2PHY_PLL_STATUS] = 0x1a0,
+	[QUSB2PHY_PORT_TUNE1] = 0x23c,
+	[QUSB2PHY_PORT_TUNE2] = 0x240,
+	[QUSB2PHY_PORT_TUNE3] = 0x244,
+	[QUSB2PHY_PORT_TUNE4] = 0x248,
+	[QUSB2PHY_PORT_TEST1] = 0x24c,
+	[QUSB2PHY_PORT_TEST2] = 0x250,
+	[QUSB2PHY_PORT_POWERDOWN] = 0x210,
+	[QUSB2PHY_INTR_CTRL] = 0x22c,
+};
+
+static const struct qusb2_phy_init_tbl msm8998_init_tbl[] = {
+	QUSB2_PHY_INIT_CFG(QUSB2PHY_PLL_ANALOG_CONTROLS_TWO, 0x13),
+	QUSB2_PHY_INIT_CFG(QUSB2PHY_PLL_CLOCK_INVERTERS, 0x7c),
+	QUSB2_PHY_INIT_CFG(QUSB2PHY_PLL_CMODE, 0x80),
+	QUSB2_PHY_INIT_CFG(QUSB2PHY_PLL_LOCK_DELAY, 0x0a),
+
+	QUSB2_PHY_INIT_CFG_L(QUSB2PHY_PORT_TUNE1, 0xa5),
+	QUSB2_PHY_INIT_CFG_L(QUSB2PHY_PORT_TUNE2, 0x09),
+
+	QUSB2_PHY_INIT_CFG(QUSB2PHY_PLL_DIGITAL_TIMERS_TWO, 0x19),
+};
+
 static const unsigned int qusb2_v2_regs_layout[] = {
 	[QUSB2PHY_PLL_CORE_INPUT_OVERRIDE] = 0xa8,
 	[QUSB2PHY_PLL_STATUS] = 0x1a0,
@@ -296,6 +326,19 @@ static const struct qusb2_phy_cfg qcs615_phy_cfg = {
 	.autoresume_en = BIT(0),
 };
 
+static const struct qusb2_phy_cfg msm8998_phy_cfg = {
+	.tbl = msm8998_init_tbl,
+	.tbl_num = ARRAY_SIZE(msm8998_init_tbl),
+	.regs = msm8998_regs_layout,
+
+	.disable_ctrl = POWER_DOWN,
+	.mask_core_ready = CORE_READY_STATUS,
+	.has_pll_override = true,
+	.se_clk_scheme_default = true,
+	.autoresume_en = BIT(0),
+	.update_tune1_with_efuse = true,
+};
+
 static const struct qusb2_phy_cfg qusb2_v2_phy_cfg = {
 	.tbl = qusb2_v2_init_tbl,
 	.tbl_num = ARRAY_SIZE(qusb2_v2_init_tbl),
@@ -352,6 +395,14 @@ static int qusb2phy_do_reset(struct qusb2_phy *qphy)
 {
 	int ret;
 
+	/*
+	 * U-Boot has no reset provider for the MSM8998 GCC (the clock node is
+	 * a stub).  ABL leaves the PHY out of reset, so a missing reset is
+	 * not fatal; just skip the pulse.
+	 */
+	if (!qphy->phy_rst.dev)
+		return 0;
+
 	ret = reset_assert(&qphy->phy_rst);
 	if (ret)
 		return ret;
@@ -391,6 +442,12 @@ static int qusb2phy_power_on(struct phy *phy)
 	clrbits_le32(qphy->base + cfg->regs[QUSB2PHY_PORT_POWERDOWN],
 		     POWER_DOWN);
 
+	/* Bring the core PLL out of reset, as Linux does. */
+	if (cfg->has_pll_override)
+		clrbits_le32(qphy->base +
+			     cfg->regs[QUSB2PHY_PLL_CORE_INPUT_OVERRIDE],
+			     CORE_RESET | CORE_RESET_MUX);
+
 	/* Required to get phy pll lock successfully */
 	udelay(150);
 
@@ -434,7 +491,8 @@ static int qusb2phy_power_off(struct phy *phy)
 	setbits_le32(qphy->base + qphy->cfg->regs[QUSB2PHY_PORT_POWERDOWN],
 		     qphy->cfg->disable_ctrl);
 
-	reset_assert(&qphy->phy_rst);
+	if (qphy->phy_rst.dev)
+		reset_assert(&qphy->phy_rst);
 
 	clk_disable(&qphy->cfg_ahb_clk);
 
@@ -477,7 +535,7 @@ static int qusb2phy_probe(struct udevice *dev)
 	}
 
 	ret = reset_get_by_index(dev, 0, &qphy->phy_rst);
-	if (ret) {
+	if (ret && ret != -ENOENT && ret != -ENOSYS && ret != -ENODEV) {
 		printf("%s: Couldn't get resets: %d\n", __func__, ret);
 		return ret;
 	}
@@ -500,6 +558,8 @@ static struct phy_ops qusb2phy_ops = {
 static const struct udevice_id qusb2phy_ids[] = {
 	{ .compatible = "qcom,msm8996-qusb2-phy",
 	  .data = (ulong)&msm8996_phy_cfg },
+	{ .compatible = "qcom,msm8998-qusb2-phy",
+	  .data = (ulong)&msm8998_phy_cfg },
 	{ .compatible = "qcom,qusb2-phy" },
 	{ .compatible = "qcom,qcm2290-qusb2-phy",
 	  .data = (ulong)&sm6115_phy_cfg },
