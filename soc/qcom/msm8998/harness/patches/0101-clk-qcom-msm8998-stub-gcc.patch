From a8aecfb44a7921adeb938d03e33e3945a7814289 Mon Sep 17 00:00:00 2001
From: Pierre-Hugues Husson <phh@phh.me>
Date: Thu, 26 Nov 2026 19:06:16 +0100
Subject: [PATCH 1/3] clk: qcom: let the MSM8998 GCC be a stub clock provider

U-Boot has no MSM8998 GCC clock or reset driver.  The dev second stage
only needs the UART and USB clocks that ABL already leaves running.
Matching the GCC node against the stub clock driver gives their drivers
a provider and a rate they can set, without pretending to reprogram the
hardware.  The real clock driver remains the long-term fix.
---
 drivers/clk/clk-stub.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/clk/clk-stub.c b/drivers/clk/clk-stub.c
index 74825f87..064cc298 100644
--- a/drivers/clk/clk-stub.c
+++ b/drivers/clk/clk-stub.c
@@ -49,6 +49,13 @@ static struct clk_ops stub_clk_ops = {
 };
 
 static const struct udevice_id stub_clk_ids[] = {
+	/*
+	 * U-Boot has no MSM8998 GCC clock/reset driver.  The dev second stage
+	 * only needs the UART and USB clocks that ABL already leaves running;
+	 * treating the GCC as a stub gives their drivers a provider and a
+	 * settable rate without pretending to reprogram the hardware.
+	 */
+	{ .compatible = "qcom,gcc-msm8998" },
 	{ .compatible = "qcom,qcs615-rpmh-clk" },
 	{ .compatible = "qcom,rpmcc" },
 	{ .compatible = "qcom,sc7180-rpmh-clk" },
