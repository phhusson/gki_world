--- a/drivers/phy/qcom/msm8916-usbh-phy.c
+++ b/drivers/phy/qcom/msm8916-usbh-phy.c
@@ -19,15 +19,34 @@
 #define GEN2_SESS_VLD_CTRL_EN		BIT(7)
 #define SESS_VLD_CTRL			BIT(25)
 
+#ifndef ULPI_EXT_VENDOR_SPECIFIC
+#define ULPI_EXT_VENDOR_SPECIFIC	0x80
+#endif
+
 struct msm_phy_priv {
 	void __iomem *regs;
 	struct usb_ehci *ehci; /* Start of IP core*/
 	struct ulpi_viewport ulpi_vp; /* ULPI Viewport */
 };
 
+/* Vendor-specific PHY setup from the MSM8916/8909 device tree. */
+static const u8 msm_phy_init_seq[][2] = {
+	{ 0x00, 0x44 },
+	{ 0x01, 0x6b },
+	{ 0x02, 0x24 },
+	{ 0x03, 0x13 },
+};
+
 static int msm_phy_power_on(struct phy *phy)
 {
 	struct msm_phy_priv *priv = dev_get_priv(phy->dev);
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(msm_phy_init_seq); i++)
+		ulpi_write(&priv->ulpi_vp,
+			   (u8 *)(ULPI_EXT_VENDOR_SPECIFIC +
+				  msm_phy_init_seq[i][0]),
+			   msm_phy_init_seq[i][1]);
 
 	/* Select and enable external configuration with USB PHY */
 	ulpi_write(&priv->ulpi_vp, (u8 *)ULPI_MISC_A_SET,
