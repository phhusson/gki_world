+/* MSM8909 exposes GPLL0 lock in GPLL0_MODE bit 30, not 0x2101c bit 17. */
+static struct pll_vote_clk gpll0_vote_clk_8909 = {
+	.status = 0x21000,
+	.status_bit = 30,
+	.ena_vote = APCS_GPLL_ENA_VOTE,
