 	/* 800Mhz/div, gpll0 */
 	clk_rcg_set_rate_mnd(priv->base, SDCC_CMD_RCGR(slot), div, 0, 0,
 			     CFG_CLK_SRC_GPLL0, 8);
-	clk_enable_gpll0(priv->base, &gpll0_vote_clk);
+	clk_enable_gpll0(priv->base, priv->data->gpll0);
 
 	return rate;
 }
 
 /* UART: 115200 */
-int apq8016_clk_init_uart(phys_addr_t base, unsigned long id)
+int apq8016_clk_init_uart(phys_addr_t base, unsigned long id,
+			  const struct pll_vote_clk *gpll0)
 {
 	u32 cmd_rcgr, apps_cbcr;
 
@@ -102,7 +111,7 @@ int apq8016_clk_init_uart(phys_addr_t base, unsigned long id)
 			     16);
 
 	/* Vote for gpll0 clock */
-	clk_enable_gpll0(base, &gpll0_vote_clk);
+	clk_enable_gpll0(base, gpll0);
 
 	/* Enable core clk */
 	clk_enable_cbc(base + apps_cbcr);
@@ -121,7 +130,7 @@ static ulong apq8016_clk_set_rate(struct clk *clk, ulong rate)
 		return apq8016_clk_init_sdc(priv, 1, rate);
 	case GCC_BLSP1_UART1_APPS_CLK: /* UART1 */
 	case GCC_BLSP1_UART2_APPS_CLK: /* UART2 */
-		apq8016_clk_init_uart(priv->base, clk->id);
+		apq8016_clk_init_uart(priv->base, clk->id, priv->data->gpll0);
 		return 7372800;
 	case GCC_USB_HS_SYSTEM_CLK:
 		if (rate != 80000000)
@@ -154,6 +163,15 @@ static struct msm_clk_data apq8016_clk_data = {
 	.clks = apq8016_clks,
 	.num_clks = ARRAY_SIZE(apq8016_clks),
 	.enable = apq8016_clk_enable,
+	.gpll0 = &gpll0_vote_clk,
+};
+
+static struct msm_clk_data msm8909_clk_data = {
+	.set_rate = apq8016_clk_set_rate,
+	.clks = apq8016_clks,
+	.num_clks = ARRAY_SIZE(apq8016_clks),
+	.enable = apq8016_clk_enable,
+	.gpll0 = &gpll0_vote_clk_8909,
