# Qualcomm MSM8909 dev second stage: USB fastboot, pstore and watchdog.
#
# The arch/board basics live in configs/gkiw-msm8909_defconfig; this fragment
# adds the harness transports and removes drivers the loader must not probe.

CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/gkiw-msm8909/gkiw-msm8909.env"

CONFIG_LMB=y
CONFIG_FASTBOOT_BUF_ADDR=0x90000000
CONFIG_FASTBOOT_BUF_SIZE=0x08000000
CONFIG_FASTBOOT_CMD_OEM_PSTORE=y
CONFIG_CMD_GKIW=y
CONFIG_CMD_FASTBOOT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_VENDOR_NUM=0x18d1
CONFIG_USB_GADGET_PRODUCT_NUM=0xd00d
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_MSM=y
CONFIG_CI_UDC=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT_REBOOT=y
CONFIG_FASTBOOT_CMD_OEM_PSTORE_DISPLAY=y

# Persistent 2ndstage console log, two 64 KiB slots.  The Linux DT must
# reserve the same window with no-map.
CONFIG_GKIW_LOG_ADDR=0x9f100000
CONFIG_GKIW_LOG_SIZE=0x20000
CONFIG_CONSOLE_RECORD=y
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x100000

# U-Boot's ramoops decoder.  These sizes must match the Linux DT.
CONFIG_CMD_PSTORE=y
CONFIG_CMD_PSTORE_MEM_ADDR=0x9f000000
CONFIG_CMD_PSTORE_MEM_SIZE=0x100000
CONFIG_CMD_PSTORE_RECORD_SIZE=0x20000
CONFIG_CMD_PSTORE_CONSOLE_SIZE=0x60000
CONFIG_CMD_PSTORE_FTRACE_SIZE=0x20000
CONFIG_CMD_PSTORE_PMSG_SIZE=0x20000
CONFIG_CMD_PSTORE_ECC_SIZE=16

# APCS watchdog at 0xb017000, 32.768 kHz sleep clock.  0xfffff ticks is
# about 32 s, so stay below it.
CONFIG_WDT=y
CONFIG_WDT_QCOM=y
CONFIG_SYSRESET_WATCHDOG=y
CONFIG_SYSRESET_WATCHDOG_AUTO=y
CONFIG_GKIW_WDT_TIMEOUT_MS=15000
# The early direct APCS arm in arch_cpu_init() covers boot; board_late_init()
# disarms it once fastboot is about to start.  Do not let initr_watchdog()
# arm a second, unserviced watchdog.
# CONFIG_WATCHDOG_AUTOSTART is not set
CONFIG_WATCHDOG_TIMEOUT_MSECS=30000

# Keep the dev second stage off storage, networking, display and PMIC code.
# CONFIG_MMC is not set
# CONFIG_CMD_MMC is not set
# CONFIG_MMC_SDHCI is not set
# CONFIG_MMC_SDHCI_MSM is not set
# CONFIG_SCSI is not set
# CONFIG_CMD_SCSI is not set
# CONFIG_UFS is not set
# CONFIG_CMD_UFS is not set
# CONFIG_DM_PMIC is not set
# CONFIG_PMIC_QCOM is not set
# CONFIG_SPMI_MSM is not set
# CONFIG_DM_REGULATOR is not set
# CONFIG_BUTTON_CMD is not set
# CONFIG_BUTTON_KEYBOARD is not set
# CONFIG_BUTTON_QCOM_PMIC is not set
# CONFIG_BUTTON_REMAP_PHONE_KEYS is not set
# CONFIG_USB_HOST_ETHER is not set
# CONFIG_USB_FUNCTION_ACM is not set
# CONFIG_FASTBOOT_FLASH is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_VIDEO is not set
# CONFIG_DM_VIDEO is not set
# CONFIG_NET is not set
# CONFIG_DM_ETH is not set
# CONFIG_RNG_MSM is not set
# CONFIG_QCOM_HYP_SMMU is not set
# CONFIG_IOMMU is not set
# CONFIG_INTERCONNECT is not set
# CONFIG_QCOM_RPMH is not set
# CONFIG_QCOM_COMMAND_DB is not set
# CONFIG_QCOM_RPMH_POWER_DOMAIN is not set

# OpenSSL 4 removed the ENGINE API used by U-Boot's host signing tools.
# CONFIG_TOOLS_KWBIMAGE is not set
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_FIT_SIGNATURE is not set
CONFIG_PHY=y
CONFIG_MSM8916_USB_PHY=y
