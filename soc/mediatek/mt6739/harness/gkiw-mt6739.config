# MediaTek MT6739 development bootloader: UART + USB fastboot + watchdog.
#
# The first stage has already initialised DDR, the UART pinmux and the USB
# clocks.  Only the MUSB gadget, the top reset controller and U-Boot's own
# helpers are needed.

CONFIG_DEBUG_UART_ANNOUNCE=y
# LK puts the visible framebuffer near the top of RAM (0x77ad0000).  The
# default 512 MiB U-Boot MMU map does not cover it, so C framebuffer writes
# fault.  Map 1 GiB; the board has at least 2 GiB.
CONFIG_MTK_MEM_MAP_DDR_SIZE=0x40000000
# Not needed by the 2ndstage and another early-init variable to trip over.
# CONFIG_EFI_LOADER is not set
CONFIG_CMD_FASTBOOT=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT_BUF_ADDR=0x50000000
CONFIG_FASTBOOT_BUF_SIZE=0x08000000
CONFIG_FASTBOOT_CMD_OEM_PSTORE=y
CONFIG_FASTBOOT_CMD_OEM_PSTORE_DISPLAY=y
CONFIG_FASTBOOT_REBOOT=y
CONFIG_CMD_GKIW=y
CONFIG_ANDROID_BOOT_IMAGE=y
CONFIG_CMD_BOOTM=y

CONFIG_WDT=y
CONFIG_WDT_MTK=y
CONFIG_CMD_WDT=y
# Bringup: start the watchdog, but do NOT let U-Boot service it yet.  A hang
# in MUSB/PHY or fastboot init must reset the phone instead of hanging.  Turn
# CONFIG_WATCHDOG on once fastboot enumeration works.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=15000
# Timeout used by fastboot_preboot() and the bare "gkiw watchdog" command.
# The MT6739 TOPRGU counter is 16-bit at 32768 Hz, so the maximum useful
# timeout is about 16 seconds.
CONFIG_GKIW_WDT_TIMEOUT_MS=15000
# Development aid: encode boot progress in the watchdog timeout.  The reset
# interval then says how far U-Boot got without a console or fastboot.
CONFIG_GKIW_BRINGUP_BEACONS=y

CONFIG_GKIW_LOG_ADDR=0x5c100000
CONFIG_GKIW_LOG_SIZE=0x20000
CONFIG_CONSOLE_RECORD=y
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x100000
# Silence the UART while pstore-display decodes; the console record still
# captures the output for fastboot.
CONFIG_SILENT_CONSOLE=y

# U-Boot's own ramoops/pstore decoder: `pstore display dmesg|console|pmsg`.
CONFIG_CMD_PSTORE=y
CONFIG_CMD_PSTORE_MEM_ADDR=0x5c000000
CONFIG_CMD_PSTORE_MEM_SIZE=0x100000
CONFIG_CMD_PSTORE_RECORD_SIZE=0x20000
CONFIG_CMD_PSTORE_CONSOLE_SIZE=0x80000
CONFIG_CMD_PSTORE_FTRACE_SIZE=0x10000
CONFIG_CMD_PSTORE_PMSG_SIZE=0x10000
CONFIG_CMD_PSTORE_ECC_SIZE=0

# The dev bootloader runs from a fixed 512 MiB window and does not relocate.
CONFIG_SKIP_RELOCATE=y

# No eMMC/SD, Ethernet, display, audio or USB host in the development image.
# CONFIG_MMC is not set
# CONFIG_CMD_MMC is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_XHCI_MTK is not set
# CONFIG_VIDEO is not set
# CONFIG_NET is not set
# CONFIG_DM_ETH is not set
# CONFIG_CMD_NET is not set

CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="fastboot usb 0"
CONFIG_BOOTDELAY=1

# OpenSSL 4 removed the ENGINE API used by U-Boot's host signing tools.
# This bootloader boots unsigned Android images and does not need them.
# CONFIG_TOOLS_KWBIMAGE is not set
# CONFIG_TOOLS_LIBCRYPTO is not set
# CONFIG_FIT_SIGNATURE is not set
