+/*
+ * The MT6356/MT6357 RTC lives behind the PMIC wrapper.  LK uses the RTC
+ * PDN1 factory-reset bit as its reboot-to-recovery request, so the second
+ * stage can implement fastboot reboot-recovery without MMC/BCB access.
+ */
+#define MTK_PWRAP_BASE		0x1000d000
+#define MTK_PWRAP_WACS2_CMD	(MTK_PWRAP_BASE + 0x09c)
+#define MTK_PWRAP_WACS2_RDATA	(MTK_PWRAP_BASE + 0x0a0)
+#define MTK_PWRAP_WACS2_VLDCLR	(MTK_PWRAP_BASE + 0x0a4)
+
+#define MTK_WACS_FSM_IDLE	0
+#define MTK_WACS_FSM_WFVLDCLR	6
+#define MTK_WACS_INIT_DONE	1
+
+#define MTK_RTC_BASE		0x980
+#define MTK_RTC_BBPU		(MTK_RTC_BASE + 0x088)
+#define MTK_RTC_PDN1		(MTK_RTC_BASE + 0x0b4)
+#define MTK_RTC_PROT		(MTK_RTC_BASE + 0x0bc)
+#define MTK_RTC_WRTGR		(MTK_RTC_BASE + 0x0c2)
+#define MTK_RTC_PROT_UNLOCK1	0x586a
+#define MTK_RTC_PROT_UNLOCK2	0x9136
+#define MTK_RTC_PDN1_FAC_RESET	BIT(4)
+#define MTK_RTC_BBPU_CBUSY	BIT(6)
+
+static int gkiw_pwrap_wait(u32 fsm)
+{
+	u32 i, val;
+
+	for (i = 0; i < 10000; i++) {
+		val = readl(MTK_PWRAP_WACS2_RDATA);
+		if (((val >> 16) & 7) == fsm &&
+		    ((val >> 21) & 1) == MTK_WACS_INIT_DONE)
+			return 0;
+		udelay(10);
+	}
+
+	return -ETIMEDOUT;
+}
+
+static int gkiw_pwrap_read(u32 reg, u16 *val)
+{
+	int ret;
+
+	ret = gkiw_pwrap_wait(MTK_WACS_FSM_IDLE);
+	if (ret)
+		return ret;
+
+	writel((reg >> 1) << 16, MTK_PWRAP_WACS2_CMD);
+	ret = gkiw_pwrap_wait(MTK_WACS_FSM_WFVLDCLR);
+	if (ret)
+		return ret;
+
+	*val = readl(MTK_PWRAP_WACS2_RDATA) & 0xffff;
+	writel(1, MTK_PWRAP_WACS2_VLDCLR);
+	return 0;
+}
+
+static int gkiw_pwrap_write(u32 reg, u16 val)
+{
+	int ret;
+
+	ret = gkiw_pwrap_wait(MTK_WACS_FSM_IDLE);
+	if (ret)
+		return ret;
+
+	writel(BIT(31) | ((reg >> 1) << 16) | val, MTK_PWRAP_WACS2_CMD);
+	return gkiw_pwrap_wait(MTK_WACS_FSM_IDLE);
+}
+
+static int gkiw_rtc_trigger(void)
+{
+	u32 i;
+	u16 val;
+	int ret;
+
+	ret = gkiw_pwrap_write(MTK_RTC_WRTGR, 1);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < 1000; i++) {
+		ret = gkiw_pwrap_read(MTK_RTC_BBPU, &val);
+		if (ret)
+			return ret;
+		if (!(val & MTK_RTC_BBPU_CBUSY))
+			return 0;
+		udelay(10);
+	}
+
+	return -ETIMEDOUT;
+}
+
+static int gkiw_rtc_set_recovery(void)
+{
+	u16 pdn1;
+	int ret;
+
+	ret = gkiw_pwrap_write(MTK_RTC_PROT, MTK_RTC_PROT_UNLOCK1);
+	if (ret)
+		return ret;
+	ret = gkiw_rtc_trigger();
+	if (ret)
+		return ret;
+
+	ret = gkiw_pwrap_write(MTK_RTC_PROT, MTK_RTC_PROT_UNLOCK2);
+	if (ret)
+		return ret;
+	ret = gkiw_rtc_trigger();
+	if (ret)
+		return ret;
+
+	ret = gkiw_pwrap_read(MTK_RTC_PDN1, &pdn1);
+	if (ret)
+		return ret;
+
+	pdn1 |= MTK_RTC_PDN1_FAC_RESET;
+	ret = gkiw_pwrap_write(MTK_RTC_PDN1, pdn1);
+	if (ret)
+		return ret;
+
+	return gkiw_rtc_trigger();
+}
+
+int fastboot_set_reboot_flag(enum fastboot_reboot_reason reason)
+{
+	int ret;
+
+	if (reason != FASTBOOT_REBOOT_REASON_RECOVERY)
+		return 0;
+
+	ret = gkiw_rtc_set_recovery();
+	printf("gkiw: recovery reboot flag %s (%d)\n",
+	       ret ? "failed" : "set", ret);
+	return ret;
+}
+
+/*
+ * OEM hook for the development loop.  "fastboot oem gkiw ..." runs a
+ * second-stage command and, for the watchdog, remembers the requested
+ * timeout for the upcoming fastboot_preboot().
+ */
+void fastboot_oem_board(char *cmd_parameter, void *data, u32 size,
+			char *response)
+{
+	const char *arg;
+
+	if (!cmd_parameter || strncmp(cmd_parameter, "gkiw ", 5)) {
+		fastboot_fail("unsupported oem command", response);
+		return;
+	}
+
+	arg = cmd_parameter + 5;
+	if (!strcmp(arg, "watchdog auto")) {
+		env_set("gkiw_wdt_preboot", NULL);
+		if (run_command("gkiw watchdog", 0)) {
+			fastboot_fail("watchdog arm failed", response);
+			return;
+		}
+		fastboot_okay(NULL, response);
+		return;
+	}
+
+	if (!strcmp(arg, "watchdog off")) {
+		env_set("gkiw_wdt_preboot", "off");
+		if (run_command("gkiw watchdog off", 0)) {
+			fastboot_fail("watchdog off failed", response);
+			return;
+		}
+		fastboot_okay(NULL, response);
+		return;
+	}
+
+	if (!strncmp(arg, "watchdog ", 9)) {
+		char cmd[64];
+		const char *ms = arg + 9;
+		char *end;
+
+		simple_strtoul(ms, &end, 10);
+		if (*end) {
+			fastboot_fail("bad watchdog timeout", response);
+			return;
+		}
+		snprintf(cmd, sizeof(cmd), "gkiw watchdog %s", ms);
+		if (run_command(cmd, 0)) {
+			fastboot_fail("watchdog arm failed", response);
+			return;
+		}
+		env_set("gkiw_wdt_preboot", ms);
+		fastboot_okay(NULL, response);
+		return;
+	}
+
+	fastboot_fail("unsupported oem gkiw command", response);
+}
