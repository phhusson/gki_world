diff --git a/drivers/usb/musb-new/musb_core.c b/drivers/usb/musb-new/musb_core.c
index 17ec0d3a..a1cb3e23 100644
--- a/drivers/usb/musb-new/musb_core.c
+++ b/drivers/usb/musb-new/musb_core.c
@@ -918,10 +918,8 @@ int musb_start(struct musb *musb)
 	musb_writeb(regs, MUSB_TESTMODE, 0);
 
 	/* put into basic highspeed mode and start session */
-	musb_writeb(regs, MUSB_POWER, MUSB_POWER_ISOUPDATE
+	musb_writeb(regs, MUSB_POWER, MUSB_POWER_ENSUSPEND
 						| MUSB_POWER_HSENAB
-						/* ENSUSPEND wedges tusb */
-						/* | MUSB_POWER_ENSUSPEND */
 						);
 
 	musb->is_active = 0;
@@ -946,8 +944,9 @@ int musb_start(struct musb *musb)
 		devctl |= MUSB_DEVCTL_SESSION;
 
 	} else /* peripheral is enabled */ {
-		if ((devctl & MUSB_DEVCTL_VBUS) == MUSB_DEVCTL_VBUS)
-			musb->is_active = 1;
+		/* MTK peripheral-only: start the session/pull-up explicitly. */
+		devctl |= MUSB_DEVCTL_SESSION;
+		musb->is_active = 1;
 	}
 
 #ifndef __UBOOT__
