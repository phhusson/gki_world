diff --git a/drivers/usb/musb-new/mt6739.c b/drivers/usb/musb-new/mt6739.c
new file mode 100644
index 00000000..507137d1
--- /dev/null
+++ b/drivers/usb/musb-new/mt6739.c
@@ -0,0 +1,261 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT6739 MUSB glue layer.
+ *
+ * The MT6739 integrates a Mentor Graphics MUSB controller with a MediaTek
+ * USB 2.0 PHY.  The stock first stage has already powered the PHY rails, but
+ * it may gate the controller clock before jumping, so this glue re-enables the
+ * USB gates and mux, releases the PHY, forces device mode and hands the
+ * controller to the generic MUSB gadget core.
+ *
+ * Based on drivers/usb/musb-new/mt85xx.c (GPL-2.0), reduced to what the
+ * development second stage needs.
+ */
+
+#include <dm.h>
+#include <dm/device_compat.h>
+#include <dm/read.h>
+#include <asm/io.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/printk.h>
+#include <linux/usb/musb.h>
+#include <usb.h>
+#include "linux-compat.h"
+#include "musb_core.h"
+#include "musb_uboot.h"
+
+extern void gkiw_usb_stage(int stage);
+
+struct mt6739_musb_glue {
+	struct musb_host_data mdata;
+	void __iomem *phy;
+	struct device dev;
+};
+
+#define to_mt6739_musb_glue(d)	container_of(d, struct mt6739_musb_glue, dev)
+
+/*
+ * The MT6739 T-PHY is the "usb-phy@800" child of the 0x11cc0000 block; the
+ * vendor macros also add 0x800 to the second "reg" base.  Keep the offset
+ * explicit so a DT that points at the block base works too.
+ */
+#define MTK_USBPHY_OFFSET		0x800
+
+/* MT6739 USB 2.0 PHY registers, relative to the PHY port. */
+#define MTK_USBPHY_GPIO_CTL		0x20
+#define MTK_USBPHY_USB_CTL		0x68
+#define MTK_USBPHY_MISC			0x6c
+
+/*
+ * Clock control.  The MT6739 kernel clock driver describes CLK_INFRA_ICUSB as
+ * an active-low gate in INFRA_AO (MODULE_SW_CG_0_CLR) and CLK_TOP_USB_TOP_SEL
+ * as a mux in TOPCKGEN (CLK_CFG_7, updated by CLK_CFG_UPDATE bit 30).
+ * U-Boot has no MT6739 clock driver yet, and the first stage may gate the
+ * controller before booting U-Boot, so program the two registers directly.
+ */
+#define MTK_INFRA_AO_BASE		0x10001000
+#define MTK_INFRA0_CG_CLR		0x84
+#define MTK_INFRA_ICUSB_BIT		8
+
+#define MTK_TOPCKGEN_BASE		0x10000000
+#define MTK_CLK_CFG_UPDATE		0x04
+#define MTK_CLK_CFG_7_SET		0xb4
+#define MTK_USB_TOP_SEL_BIT		24
+#define MTK_USB_TOP_UPDATE_BIT		30
+
+static void mt6739_usb_clocks_enable(void)
+{
+	void __iomem *infra = (void __iomem *)MTK_INFRA_AO_BASE;
+	void __iomem *top = (void __iomem *)MTK_TOPCKGEN_BASE;
+
+	/* usb_top_sel = univpll3_d4 (parent index 1). */
+	writel(BIT(MTK_USB_TOP_SEL_BIT), top + MTK_CLK_CFG_7_SET);
+	setbits_le32(top + MTK_CLK_CFG_UPDATE, BIT(MTK_USB_TOP_UPDATE_BIT));
+	udelay(20);
+
+	/* infra_icusb gate is active-low: clear it to enable the clock. */
+	writel(BIT(MTK_INFRA_ICUSB_BIT), infra + MTK_INFRA0_CG_CLR);
+	udelay(20);
+}
+
+static void mt6739_usb_phy_recover(void __iomem *phy)
+{
+	/* The vendor glue waits 10 ms after enabling the controller clock. */
+	mdelay(10);
+
+	/* Wait for the PHY 3.3 V / 1.8 V rails to settle. */
+	udelay(50);
+
+	/* Leave UART/JTAG mode. */
+	clrbits_le32(phy + 0x1c, BIT(12));
+	clrbits_le32(phy + MTK_USBPHY_USB_CTL, BIT(26));
+	clrbits_le32(phy + MTK_USBPHY_MISC, BIT(16));
+	clrbits_le32(phy + MTK_USBPHY_GPIO_CTL, BIT(9) | BIT(8));
+
+	/* dp_100k_mode = 1; dp/dm_100k_en = 0. */
+	setbits_le32(phy + MTK_USBPHY_GPIO_CTL, BIT(18));
+	clrbits_le32(phy + MTK_USBPHY_GPIO_CTL, BIT(16) | BIT(17));
+
+	/* Release suspend and the test pulls. */
+	clrbits_le32(phy + MTK_USBPHY_USB_CTL, BIT(18));
+	clrbits_le32(phy + MTK_USBPHY_USB_CTL,
+		     BIT(6) | BIT(7) | (0x3 << 4) | BIT(2) | (0xf << 10));
+	clrbits_le32(phy + MTK_USBPHY_USB_CTL,
+		     BIT(20) | BIT(21) | BIT(19) | BIT(17) | BIT(23));
+	clrbits_le32(phy + 0x18, BIT(23));
+
+	udelay(800);
+
+	/* LK/recover: enable VBUS comparator and set PHY_REV to 0x40. */
+	setbits_le32(phy + 0x18, BIT(20));
+	clrbits_le32(phy + 0x18, 0xff << 24);
+	setbits_le32(phy + 0x18, 0x40 << 24);
+
+	/* Force device mode: VBUSVALID/AVALID/BVALID/IDDIG/IDPULLUP. */
+	clrsetbits_le32(phy + MTK_USBPHY_MISC, 0x10, 0x2f);
+	setbits_le32(phy + MTK_USBPHY_MISC, 0x3f << 8);
+}
+
+static irqreturn_t mt6739_musb_interrupt(int irq, void *__hci)
+{
+	struct musb *musb = __hci;
+	irqreturn_t retval = IRQ_NONE;
+
+	musb->int_usb = musb_readb(musb->mregs, MUSB_INTRUSB);
+	if (musb->int_usb) {
+		if (musb->int_usb & MUSB_INTR_RESET)
+			gkiw_usb_stage(6);
+		if (musb->int_usb & MUSB_INTR_CONNECT)
+			gkiw_usb_stage(7);
+		musb_writeb(musb->mregs, MUSB_INTRUSB, musb->int_usb);
+	}
+	musb->int_tx = musb_readw(musb->mregs, MUSB_INTRTX);
+	if (musb->int_tx)
+		musb_writew(musb->mregs, MUSB_INTRTX, musb->int_tx);
+	musb->int_rx = musb_readw(musb->mregs, MUSB_INTRRX);
+	if (musb->int_rx)
+		musb_writew(musb->mregs, MUSB_INTRRX, musb->int_rx);
+
+	if (musb->int_usb || musb->int_tx || musb->int_rx)
+		retval = musb_interrupt(musb);
+
+	return retval;
+}
+
+static int mt6739_musb_init(struct musb *musb)
+{
+	musb->isr = mt6739_musb_interrupt;
+
+	return 0;
+}
+
+static int mt6739_musb_enable(struct musb *musb)
+{
+	struct mt6739_musb_glue *glue = to_mt6739_musb_glue(musb->controller);
+
+	musb_ep_select(musb->mregs, 0);
+	musb_writeb(musb->mregs, MUSB_FADDR, 0);
+
+	mt6739_usb_phy_recover(glue->phy);
+
+	return 0;
+}
+
+static void mt6739_musb_disable(struct musb *musb)
+{
+}
+
+static const struct musb_platform_ops mt6739_musb_ops = {
+	.init		= mt6739_musb_init,
+	.enable		= mt6739_musb_enable,
+	.disable	= mt6739_musb_disable,
+};
+
+#define MT6739_MUSB_MAX_EP_NUM	8
+#define MT6739_MUSB_RAM_BITS	16
+
+static struct musb_fifo_cfg mt6739_musb_mode_cfg[] = {
+	MUSB_EP_FIFO_SINGLE(1, FIFO_TX, 512),
+	MUSB_EP_FIFO_SINGLE(1, FIFO_RX, 512),
+	MUSB_EP_FIFO_SINGLE(2, FIFO_TX, 512),
+	MUSB_EP_FIFO_SINGLE(2, FIFO_RX, 512),
+	MUSB_EP_FIFO_SINGLE(3, FIFO_TX, 512),
+	MUSB_EP_FIFO_SINGLE(3, FIFO_RX, 512),
+	MUSB_EP_FIFO_SINGLE(4, FIFO_TX, 512),
+	MUSB_EP_FIFO_SINGLE(4, FIFO_RX, 512),
+	MUSB_EP_FIFO_SINGLE(5, FIFO_TX, 512),
+	MUSB_EP_FIFO_SINGLE(5, FIFO_RX, 512),
+	MUSB_EP_FIFO_SINGLE(6, FIFO_TX, 512),
+	MUSB_EP_FIFO_SINGLE(6, FIFO_RX, 512),
+	MUSB_EP_FIFO_SINGLE(7, FIFO_TX, 512),
+	MUSB_EP_FIFO_SINGLE(7, FIFO_RX, 512),
+};
+
+static struct musb_hdrc_config mt6739_musb_config = {
+	.fifo_cfg	= mt6739_musb_mode_cfg,
+	.fifo_cfg_size	= ARRAY_SIZE(mt6739_musb_mode_cfg),
+	.multipoint	= true,
+	.dyn_fifo	= true,
+	.num_eps	= MT6739_MUSB_MAX_EP_NUM,
+	.ram_bits	= MT6739_MUSB_RAM_BITS,
+};
+
+static int mt6739_musb_probe(struct udevice *dev)
+{
+	struct mt6739_musb_glue *glue = dev_get_priv(dev);
+	struct musb_host_data *host = &glue->mdata;
+	struct musb_hdrc_platform_data pdata;
+	void *base = dev_read_addr_ptr(dev);
+
+	if (!base)
+		return -EINVAL;
+
+	glue->phy = dev_read_addr_index_ptr(dev, 1);
+	if (!glue->phy)
+		return -EINVAL;
+	glue->phy += MTK_USBPHY_OFFSET;
+
+	mt6739_usb_clocks_enable();
+
+	memset(&pdata, 0, sizeof(pdata));
+	pdata.min_power = 250;	/* 500 mA, in mA/2 units */
+	pdata.platform_ops = &mt6739_musb_ops;
+	pdata.config = &mt6739_musb_config;
+	pdata.mode = MUSB_PERIPHERAL;
+
+	host->host = musb_register(&pdata, &glue->dev, base);
+	if (!host->host)
+		return -EIO;
+
+	printf("MT6739 MUSB OTG (Peripheral)\n");
+
+	return 0;
+}
+
+static int mt6739_musb_remove(struct udevice *dev)
+{
+	struct mt6739_musb_glue *glue = dev_get_priv(dev);
+	struct musb_host_data *host = &glue->mdata;
+
+	musb_stop(host->host);
+	free(host->host);
+	host->host = NULL;
+
+	return 0;
+}
+
+static const struct udevice_id mt6739_musb_ids[] = {
+	{ .compatible = "mediatek,mt6739-usb20" },
+	{ }
+};
+
+U_BOOT_DRIVER(mt6739_musb) = {
+	.name		= "mt6739_musb",
+	.id		= UCLASS_USB_GADGET_GENERIC,
+	.of_match	= mt6739_musb_ids,
+	.probe		= mt6739_musb_probe,
+	.remove		= mt6739_musb_remove,
+	.plat_auto	= sizeof(struct usb_plat),
+	.priv_auto	= sizeof(struct mt6739_musb_glue),
+};
