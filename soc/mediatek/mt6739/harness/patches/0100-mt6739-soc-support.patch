diff --git a/board/mediatek/mt6739/board.c b/board/mediatek/mt6739/board.c
new file mode 100644
index 00000000..cbfc4387
--- /dev/null
+++ b/board/mediatek/mt6739/board.c
@@ -0,0 +1,297 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * K-Touch i9 (MT6739) development board.
+ *
+ * The board file is deliberately tiny: the stock first stage owns DDR, PSCI,
+ * the UART pinmux and the USB PHY power rails.  U-Boot only needs to publish
+ * the board name, re-enable the UART/USB gates the first stage may have
+ * closed, and bring up the fastboot gadget.
+ */
+
+#include <config.h>
+#include <console.h>
+#include <dm.h>
+#include <env.h>
+#include <fastboot.h>
+#include <linux/libfdt.h>
+#include <init.h>
+#include <log.h>
+#include <usb.h>
+#include <wdt.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <cpu_func.h>
+#include <linux/bitops.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#if CONFIG_IS_ENABLED(GKIW_BRINGUP_BEACONS)
+#define MTK_WDT_BASE		0x10007000
+#define MTK_WDT_MODE		0x00
+#define MTK_WDT_LENGTH		0x04
+#define MTK_WDT_RESTART		0x08
+#define WDT_MODE_KEY		(0x22u << 24)
+#define WDT_MODE_EN		BIT(0)
+#define WDT_MODE_EXTEN		BIT(2)
+#define WDT_LENGTH_KEY		0x8
+#define WDT_RESTART_KEY		0x1971
+
+/*
+ * Start the TOPRGU watchdog before the debug UART is touched.  If the UART
+ * clock/domain is the thing that hangs, this still gives a reset; if U-Boot
+ * never starts, the first-stage timer is what resets instead.
+ */
+static void mt6739_wdt_start_early(unsigned int ms)
+{
+	void __iomem *wdt = (void __iomem *)MTK_WDT_BASE;
+	unsigned int count = (ms * 1000 + 15624) / 15625;
+
+	if (count > 1023)
+		count = 1023;
+	writel((count << 5) | WDT_LENGTH_KEY, wdt + MTK_WDT_LENGTH);
+	writel(WDT_RESTART_KEY, wdt + MTK_WDT_RESTART);
+	setbits_le32(wdt + MTK_WDT_MODE,
+		     WDT_MODE_KEY | WDT_MODE_EN | WDT_MODE_EXTEN);
+}
+
+/*
+ * Encode boot progress in the watchdog timeout.  With CONFIG_WATCHDOG off the
+ * timer is started but never serviced, so the reset interval tells a
+ * console-less board how far U-Boot got.
+ */
+static void gkiw_beacon(unsigned int ms)
+{
+	struct udevice *dev;
+
+	if (uclass_get_device(UCLASS_WDT, 0, &dev))
+		return;
+	wdt_start(dev, ms, 0);
+}
+#else
+static inline void gkiw_beacon(unsigned int ms) { }
+#endif
+
+/*
+ * INFRA_AO / TOPCKGEN clock controls.  U-Boot has no MT6739 clock driver, and
+ * the first stage may gate UART0 before jumping, so the debug console has to
+ * re-enable it before the first character is written.
+ */
+#define MTK_INFRA_AO_BASE		0x10001000
+#define MTK_INFRA0_CG_CLR		0x84
+#define MTK_INFRA_UART0_BIT		22
+
+#define MTK_TOPCKGEN_BASE		0x10000000
+#define MTK_CLK_CFG_UPDATE		0x04
+#define MTK_CLK_CFG_2_CLR		0x68
+#define MTK_UART_SEL_BIT		8
+#define MTK_UART_UPDATE_BIT		9
+
+#if CONFIG_IS_ENABLED(DEBUG_UART_BOARD_INIT)
+void board_debug_uart_init(void)
+{
+	void __iomem *infra = (void __iomem *)MTK_INFRA_AO_BASE;
+	void __iomem *top = (void __iomem *)MTK_TOPCKGEN_BASE;
+
+#if CONFIG_IS_ENABLED(GKIW_BRINGUP_BEACONS)
+	/* Beacon 3s: U-Boot reached the debug UART hook. */
+	mt6739_wdt_start_early(3000);
+#endif
+
+	/* uart_sel = clk26m (parent index 0); update it in TOPCKGEN. */
+	writel(BIT(MTK_UART_SEL_BIT), top + MTK_CLK_CFG_2_CLR);
+	setbits_le32(top + MTK_CLK_CFG_UPDATE, BIT(MTK_UART_UPDATE_BIT));
+
+	/* infra_uart0 gate is active-low: clear it to enable the clock. */
+	writel(BIT(MTK_INFRA_UART0_BIT), infra + MTK_INFRA0_CG_CLR);
+}
+#endif
+
+/*
+ * Visual USB bringup states for a board with no console.  The framebuffer is
+ * painted a solid colour; the last colour on screen says how far USB got.
+ * 1 blue (fastboot start), 2 cyan (init), 3 green (g_dnl registered),
+ * 4 red (register failed), 5 yellow (loop), 6 magenta (USB reset),
+ * 7 orange (USB connect).
+ */
+/*
+ * Best-effort display backlight off.  DISP_PWM0 is at 0x1100e000; the
+ * vendor BLS path disables PWM_EN and sets duty 0.  If this panel uses the
+ * LCM/DSI backlight path instead, this is a no-op.
+ */
+static void gkiw_backlight_off(void)
+{
+	void __iomem *pwm = (void __iomem *)0x1100e000;
+
+	writel(0, pwm + 0x00);	/* EN = 0 */
+	writel(0, pwm + 0x0c);	/* commit */
+	writel(0, pwm + 0x1c);	/* duty = 0 */
+	writel(1, pwm + 0x0c);	/* commit 1 */
+	writel(0, pwm + 0x0c);
+}
+
+static void gkiw_fb_fill(u32 color)
+{
+	volatile u32 *p, *end;
+
+	p = (volatile u32 *)0x5e605000;
+	end = (volatile u32 *)(0x5e605000 + 0x100000);
+	for (; p < end; p++)
+		*p = color;
+	flush_dcache_range(0x5e605000, 0x5e605000 + 0x100000);
+
+	p = (volatile u32 *)0x77ad0000;
+	end = (volatile u32 *)(0x77ad0000 + 0x100000);
+	for (; p < end; p++)
+		*p = color;
+	flush_dcache_range(0x77ad0000, 0x77ad0000 + 0x100000);
+}
+
+void gkiw_usb_stage(int stage)
+{
+	switch (stage) {
+	case 1: gkiw_fb_fill(0x0000ff); break;	/* blue */
+	case 2: gkiw_fb_fill(0x00ffff); break;	/* cyan */
+	case 3: gkiw_fb_fill(0x00ff00); break;	/* green */
+	case 4: gkiw_fb_fill(0xff0000); break;	/* red */
+	case 5: gkiw_fb_fill(0xffff00); break;	/* yellow */
+	case 6: gkiw_fb_fill(0xff00ff); break;	/* magenta */
+	case 7: gkiw_fb_fill(0xff8000); break;	/* orange */
+	default: break;
+	}
+
+	/* Fastboot is up: stop burning the backlight while waiting. */
+	if (stage == 5)
+		gkiw_backlight_off();
+
+	/*
+	 * Also encode the stage in the watchdog timeout.  This survives even if
+	 * the display is showing LK's logo layer: stage N => 4s + N seconds.
+	 */
+	if (CONFIG_IS_ENABLED(GKIW_BRINGUP_BEACONS) && stage > 0)
+		gkiw_beacon(4000 + stage * 1000);
+}
+
+/*
+ * LK puts the MTK efuse devinfo in /chosen/atag,devinfo in the DTB it passes
+ * at tags_addr (0x44000000).  The property is { u32 data_size; u32 data[]; }
+ * in native endian; data[10] carries 0x56ab0000 | HRID size, and the HRID
+ * bytes start at data[12].  Use it as the fastboot serial.
+ */
+static const char *gkiw_devinfo_serial(void)
+{
+	void *fdt = (void *)0x44000000;
+	const u32 *p;
+	int off, len;
+	u32 size, hrid_size, i, j, pos = 0;
+	static char serial[2 * 8 * 4 + 1];
+
+	if (fdt_check_header(fdt))
+		return NULL;
+
+	off = fdt_path_offset(fdt, "/chosen");
+	if (off < 0)
+		return NULL;
+
+	p = fdt_getprop(fdt, off, "atag,devinfo", &len);
+	if (!p || len < 4)
+		return NULL;
+
+	/* atag,devinfo is a native-endian struct, not FDT big-endian cells. */
+	size = p[0];
+	if (size > 300 || 4 + size * 4 > len)
+		return NULL;
+
+	hrid_size = 2;
+	if (size >= 11 && (p[11] & 0xffff0000) == 0x56ab0000) {
+		hrid_size = p[11] & 0xffff;
+		if (hrid_size > 8)
+			hrid_size = 8;
+		else if (hrid_size < 2)
+			hrid_size = 2;
+	}
+
+	if (size < 12 + hrid_size)
+		return NULL;
+
+	for (i = 0; i < hrid_size; i++) {
+		u32 v = p[13 + i];
+
+		for (j = 0; j < 4; j++)
+			pos += sprintf(serial + pos, "%02x",
+				       (v >> (8 * j)) & 0xff);
+	}
+	serial[pos] = '\0';
+
+	return pos ? serial : NULL;
+}
+
+int board_init(void)
+{
+	/* Address of the ATAG/boot parameters block passed to Linux. */
+	gd->bd->bi_boot_params = CFG_SYS_SDRAM_BASE + 0x100;
+
+	/* Blue: board_init reached, C framebuffer write works. */
+	gkiw_usb_stage(1);
+
+	return 0;
+}
+
+int board_late_init(void)
+{
+	/* Cyan: board_late_init reached. */
+	gkiw_usb_stage(2);
+
+#if CONFIG_IS_ENABLED(CONSOLE_RECORD)
+	/* Start a clean recording for the fastboot session and crash log. */
+	console_record_reset_enable();
+#endif
+
+	env_set("board", "ktouch-i9");
+	{
+		const char *serial = gkiw_devinfo_serial();
+
+		if (serial)
+			env_set("serial#", serial);
+		else if (!env_get("serial#"))
+			env_set("serial#", "0123456789ABCDEF");
+	}
+
+	/* Beacon 4s: reached board_late_init. */
+	gkiw_beacon(4000);
+
+	/*
+	 * Probe the gadget only after initr_watchdog(), so a hang in MUSB/PHY
+	 * initialization is caught by the U-Boot watchdog instead of leaving
+	 * the board stuck before the timer is started.
+	 */
+	if (CONFIG_IS_ENABLED(USB_GADGET)) {
+		struct udevice *dev;
+		int ret;
+
+		printf("gkiw: probing MT6739 MUSB gadget\n");
+		/* Beacon 8s: about to enter MUSB/PHY init. */
+		gkiw_beacon(8000);
+		ret = uclass_get_device(UCLASS_USB_GADGET_GENERIC, 0, &dev);
+		if (ret) {
+			pr_err("%s: cannot find USB device (%d)\n", __func__, ret);
+			/* Beacon 10s: USB probe failed. */
+			gkiw_beacon(10000);
+		} else {
+			printf("gkiw: MUSB gadget ready\n");
+			/* Beacon 12s: USB probe succeeded. */
+			gkiw_beacon(12000);
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * There is no BCB storage in the development bootloader.  A reset makes the
+ * stock first stage load the flashed second stage again, which is exactly what
+ * `fastboot reboot-bootloader` is supposed to do.
+ */
+int fastboot_set_reboot_flag(enum fastboot_reboot_reason reason)
+{
+	return 0;
+}
