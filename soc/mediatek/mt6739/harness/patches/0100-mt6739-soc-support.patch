diff --git a/arch/arm/mach-mediatek/mt6739/init.c b/arch/arm/mach-mediatek/mt6739/init.c
new file mode 100644
index 00000000..0eecd8eb
--- /dev/null
+++ b/arch/arm/mach-mediatek/mt6739/init.c
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT6739 SoC support.
+ *
+ * The gki_world second stage is chainloaded by the stock first stage, which
+ * has already initialised DDR, the PSCI monitor and the UART pinmux.  This
+ * file therefore only fills in the board information U-Boot needs and keeps
+ * the reset path independent of PSCI.
+ */
+
+#include <dm.h>
+#include <fdtdec.h>
+#include <hang.h>
+#include <asm/io.h>
+#include <asm/global_data.h>
+#include <linux/delay.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define MTK_WDT_BASE		0x10007000
+#define MTK_WDT_RESTART		0x08
+#define MTK_WDT_SWRST		0x14
+#define WDT_RESTART_KEY		0x1971
+#define WDT_SWRST_KEY		0x1209
+
+int dram_init(void)
+{
+	return fdtdec_setup_mem_size_base();
+}
+
+void reset_cpu(void)
+{
+	void __iomem *wdt = (void __iomem *)MTK_WDT_BASE;
+
+	/*
+	 * A PSCI monitor is not guaranteed to be present when U-Boot is used as
+	 * a chainloaded development payload, but the top reset controller is
+	 * always there.  Kick the watchdog and request an immediate software
+	 * reset, matching what the vendor bootloader does.
+	 */
+	writel(WDT_RESTART_KEY, wdt + MTK_WDT_RESTART);
+	writel(WDT_SWRST_KEY, wdt + MTK_WDT_SWRST);
+
+	mdelay(1000);
+	hang();
+}
+
+int print_cpuinfo(void)
+{
+	printf("CPU:   MediaTek MT6739\n");
+	return 0;
+}
diff --git a/arch/arm/mach-mediatek/mt6739/lowlevel_init.S b/arch/arm/mach-mediatek/mt6739/lowlevel_init.S
new file mode 100644
index 00000000..27dfb011
--- /dev/null
+++ b/arch/arm/mach-mediatek/mt6739/lowlevel_init.S
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * K-Touch i9 / MT6739 early entry hook.
+ *
+ * This runs at the very first instruction of U-Boot, before the stack, MMU or
+ * console exist.  Paint the LK framebuffer white so a board with no UART and
+ * no USB still gives a visible "U-Boot started" signal.  The address is the
+ * device's /chosen/atag,videolfb-fb_base (0x5e605000).
+ */
+
+#include <linux/linkage.h>
+#include <asm/system.h>
+
+ENTRY(save_boot_params)
+	mov	x9, x0
+	mov	x10, x1
+	mov	x11, x2
+	mov	x12, x3
+
+	ldr	x13, =0x5e605000
+	mov	w14, #0xffff
+	movk	w14, #0xffff, lsl #16
+	mov	w15, #0x40000		/* 256K words = 1 MiB */
+1:
+	str	w14, [x13], #4
+	subs	w15, w15, #1
+	b.ne	1b
+
+	/* LK may place the visible framebuffer at the top of RAM instead. */
+	ldr	x13, =0x77ad0000
+	mov	w15, #0x40000
+2:
+	str	w14, [x13], #4
+	subs	w15, w15, #1
+	b.ne	2b
+
+	mov	x0, x9
+	mov	x1, x10
+	mov	x2, x11
+	mov	x3, x12
+	b	save_boot_params_ret
+ENDPROC(save_boot_params)
